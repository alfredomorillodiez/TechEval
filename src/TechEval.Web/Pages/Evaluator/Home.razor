@page "/evaluacion"
@inject AuthStateService Auth
@inject NavigationManager Nav

<PageTitle>Evaluación — TechEval</PageTitle>

@* Sin llamadas a la API de datos a propósito: hasta que un administrador le asigne pruebas,
   el evaluador no debe ver pruebas, candidatos ni resultados. *@
<div class="container py-5" style="max-width:720px;">
    @if (Auth.IsEvaluador)
    {
        <h1 class="h3 mb-3">Hola, @Auth.UserName</h1>
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4 d-flex gap-3 align-items-start">
                <i class="bi bi-inbox text-primary" style="font-size:2rem;"></i>
                <div>
                    <h2 class="h5">Todavía no tienes correcciones disponibles</h2>
                    <p class="text-muted mb-0">
                        Cuando un administrador te asigne pruebas, sus correcciones pendientes
                        aparecerán aquí.
                    </p>
                </div>
            </div>
        </div>
    }
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await Auth.InitializeAsync();
        if (!Auth.IsEvaluador) Nav.NavigateTo(Auth.Home);
    }
}
