@page "/evaluacion/historial"
@implements IDisposable
@using TechEval.Application
@using TechEval.Application.DTOs
@inject ApiService Api
@inject NavigationManager Nav
@inject AuthStateService Auth
@inject ListState Lists

<PageTitle>Historial — TechEval</PageTitle>

@* Lo que corrigió el evaluador, aunque ya no tenga asignada la prueba. A ciegas, como la cola. *@
<div class="container-lg py-4">
    <h1 class="h3 mb-4">Mis correcciones</h1>

    @if (_loading)
    {
        <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
    }
    else if (_loadFailed)
    {
        <LoadError What="tu historial de correcciones" OnRetry="LoadAsync" />
    }
    else if (_history.Count == 0)
    {
        <div class="text-center text-muted py-5">Todavía no has corregido ninguna prueba.</div>
    }
    else
    {
        <div class="row g-2 mb-3 align-items-center">
            <div class="col-md-6">
                <input class="form-control" type="search" placeholder="Buscar por prueba o candidato…"
                       aria-label="Buscar en tu historial" value="@_search"
                       @oninput="e => _search = e.Value?.ToString() ?? string.Empty" />
            </div>
            <div class="col-md-auto text-muted small">
                Mostrando <strong>@Displayed.Count</strong> de @_history.Count
            </div>
        </div>
        <div class="card border-0 shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light">
                        <tr>
                            <SortHeader Key="candidate" State="_sort" OnSort="SortBy" Class="ps-3">Candidato</SortHeader>
                            <SortHeader Key="exam" State="_sort" OnSort="SortBy">Prueba</SortHeader>
                            <SortHeader Key="reviewed" State="_sort" OnSort="SortBy">Corregida</SortHeader>
                            <SortHeader Key="score" State="_sort" OnSort="SortBy">Nota</SortHeader>
                            <th class="text-end pe-3"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var h in Displayed)
                        {
                            <tr>
                                <td class="ps-3 fw-semibold">@h.CandidateAlias</td>
                                <td>@h.ExamTitle</td>
                                <td class="text-muted small">@h.ReviewedOn.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <span class="badge @(h.Passed ? "bg-success" : "bg-danger")">
                                        @h.ScorePercentage% · @(h.Passed ? "Aprobado" : "No aprobado")
                                    </span>
                                </td>
                                <td class="text-end pe-3">
                                    <a href="/evaluacion/historial/@h.ResultId" class="btn btn-sm btn-outline-primary">Ver</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading = true, _loadFailed;
    private List<EvaluatorHistoryItemDto> _history = new();

    // Búsqueda y orden se conservan al abrir una corrección y volver.
    private const string StateKey = "evaluator-history";
    private string _search = string.Empty;
    private readonly SortState _sort = new();
    private sealed record Saved(string Search, SortState Sort);

    private static readonly IReadOnlyDictionary<string, Func<EvaluatorHistoryItemDto, object?>> Columns =
        new Dictionary<string, Func<EvaluatorHistoryItemDto, object?>>
        {
            ["candidate"] = h => h.CandidateAlias,
            ["exam"] = h => h.ExamTitle,
            ["reviewed"] = h => h.ReviewedOn,
            ["score"] = h => h.ScorePercentage
        };

    private List<EvaluatorHistoryItemDto> Displayed => ListSort.Apply(
            _history.Where(h => string.IsNullOrWhiteSpace(_search)
                || h.CandidateAlias.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase)
                || h.ExamTitle.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase)),
            _sort, Columns).ToList();

    private void SortBy(string key) => _sort.Toggle(key);

    public void Dispose() => Lists.Set(StateKey, new Saved(_search, _sort.Clone()));

    protected override async Task OnInitializedAsync()
    {
        await Auth.InitializeAsync();
        if (!Auth.IsEvaluador) { Nav.NavigateTo(Auth.Home); return; }

        if (Lists.Get<Saved>(StateKey) is { } saved)
        {
            _search = saved.Search;
            _sort.Key = saved.Sort.Key; _sort.Descending = saved.Sort.Descending;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var history = await Api.GetEvaluationHistoryAsync();
        _loadFailed = history is null;
        if (history is not null) _history = history;
        _loading = false;
    }
}
