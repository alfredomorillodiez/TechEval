@page "/admin/questions/review"
@using TechEval.Application.DTOs
@using TechEval.Domain.Enums
@implements IDisposable
@inject ApiService Api
@inject NavigationManager Nav
@inject AuthStateService Auth

<PageTitle>Pendientes de revisión — TechEval</PageTitle>

<div class="container-lg py-4">
    <div class="d-flex align-items-center gap-3 mb-4">
        <a href="/admin/questions" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h1 class="h3 mb-0">Preguntas pendientes de revisión</h1>
    </div>

    @if (_loading)
    {
        <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
    }
    else
    {
        @if (_progress.Any())
        {
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body">
                    <h6 class="text-uppercase text-muted small fw-semibold mb-3">Estado de generación</h6>
                    @for (int i = 0; i < _progress.Count; i++)
                    {
                        var job = _progress[i];
                        <div class="d-flex flex-wrap align-items-center gap-2 py-2 @(i < _progress.Count - 1 ? "border-bottom" : "")">
                            <span class="badge @JobStatusClass(job.Status)">@JobStatusLabel(job.Status)</span>
                            <span class="fw-semibold">@job.Topic</span>
                            <span class="badge bg-light text-dark border">@job.CategoryName</span>
                            <span class="text-muted small ms-auto">
                                @if (job.PendingCount > 0)
                                {
                                    <span><i class="bi bi-hourglass-split"></i> @job.PendingCount generándose</span>
                                    <span class="mx-1">·</span>
                                }
                                <span class="text-success"><i class="bi bi-check-circle"></i> @job.SucceededCount lista(s)</span>
                                @if (job.FailedCount > 0)
                                {
                                    <span class="mx-1">·</span>
                                    <span class="text-danger"><i class="bi bi-x-circle"></i> @job.FailedCount fallida(s)</span>
                                }
                                <span class="mx-1">·</span>
                                <span>@job.RequestedCount solicitada(s)</span>
                            </span>
                        </div>
                    }
                </div>
            </div>
        }

        @if (!_items.Any() && !_progress.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-inbox fs-1"></i>
                <p class="mt-2">No hay generación en curso ni preguntas pendientes de revisión.</p>
            </div>
        }
        else
        {
            @foreach (var item in _items)
            {
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="badge bg-light text-dark border">
                                <i class="bi bi-collection"></i> @item.JobTopic
                            </span>
                        </div>
                        @if (item.Question is not null)
                        {
                            var q = item.Question;
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div class="d-flex flex-wrap gap-2 align-items-center">
                                    <span class="badge bg-secondary">@q.CategoryName</span>
                                    <span class="badge @DifficultyClass(q.Difficulty)">@DifficultyLabel(q.Difficulty)</span>
                                    <span class="badge bg-light text-dark border">
                                        @(q.Type == QuestionType.MultipleChoice ? "Test" : "Abierta")
                                    </span>
                                </div>
                                <div class="d-flex gap-2">
                                    <a href="/admin/questions/@q.Id" class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-pencil"></i> Editar
                                    </a>
                                    <button class="btn btn-sm btn-success" @onclick="() => ApproveAsync(item.Id)">
                                        <i class="bi bi-check-lg"></i> Aprobar
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => RejectAsync(item.Id)">
                                        <i class="bi bi-x-lg"></i> Rechazar
                                    </button>
                                </div>
                            </div>
                            <p class="fw-semibold mb-3">@q.Text</p>

                            @if (q.Type == QuestionType.MultipleChoice)
                            {
                                <div class="row g-2">
                                    @foreach (var a in q.Answers.OrderBy(x => x.Order))
                                    {
                                        <div class="col-md-6">
                                            <div class="d-flex align-items-center gap-2 px-3 py-2 rounded @(a.IsCorrect ? "bg-success bg-opacity-10 border border-success" : "bg-light")">
                                                <i class="bi @(a.IsCorrect ? "bi-check-circle-fill text-success" : "bi-circle text-muted") flex-shrink-0"></i>
                                                <span class="@(a.IsCorrect ? "fw-semibold text-success-emphasis" : "text-muted")">@a.Text</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="border rounded p-3 bg-light">
                                    <p class="text-muted small mb-1">Respuesta de referencia</p>
                                    <p class="mb-0">@q.SampleAnswer</p>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="d-flex align-items-center gap-2">
                                <span class="badge bg-danger">Error</span>
                                <span class="text-muted">@item.ErrorMessage</span>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    }
</div>

@code {
    private static readonly TimeSpan PollInterval = TimeSpan.FromSeconds(5);

    private List<QuestionGenerationJobItemDto> _items = new();
    private List<QuestionGenerationJobProgressDto> _progress = new();
    private bool _loading = true;
    private CancellationTokenSource? _pollingCts;

    protected override async Task OnInitializedAsync()
    {
        await Auth.InitializeAsync();
        if (!Auth.IsAuthenticated || !Auth.IsAdmin) { Nav.NavigateTo("/login"); return; }

        await RefreshAsync();
        _loading = false;

        _pollingCts = new CancellationTokenSource();
        _ = PollAsync(_pollingCts.Token);
    }

    private async Task PollAsync(CancellationToken ct)
    {
        var timer = new PeriodicTimer(PollInterval);
        try
        {
            while (await timer.WaitForNextTickAsync(ct))
            {
                await RefreshAsync();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // Polling detenido al salir de la página.
        }
    }

    private async Task RefreshAsync()
    {
        _items = await Api.GetPendingReviewItemsAsync() ?? new();
        _progress = await Api.GetActiveGenerationProgressAsync() ?? new();
    }

    private async Task ApproveAsync(int itemId)
    {
        if (await Api.ApproveQuestionAsync(itemId))
            _items.RemoveAll(i => i.Id == itemId);
    }

    private async Task RejectAsync(int itemId)
    {
        if (await Api.RejectQuestionAsync(itemId))
            _items.RemoveAll(i => i.Id == itemId);
    }

    private static string DifficultyClass(DifficultyLevel d) => d switch
    {
        DifficultyLevel.Basic => "bg-success",
        DifficultyLevel.Intermediate => "bg-warning text-dark",
        DifficultyLevel.Advanced => "bg-danger",
        _ => "bg-secondary"
    };

    private static string DifficultyLabel(DifficultyLevel d) => d switch
    {
        DifficultyLevel.Basic => "Básico",
        DifficultyLevel.Intermediate => "Intermedio",
        DifficultyLevel.Advanced => "Avanzado",
        _ => d.ToString()
    };

    private static string JobStatusClass(QuestionGenerationJobStatus s) => s switch
    {
        QuestionGenerationJobStatus.Running => "bg-primary",
        QuestionGenerationJobStatus.Queued => "bg-secondary",
        QuestionGenerationJobStatus.Completed => "bg-success",
        QuestionGenerationJobStatus.Failed => "bg-danger",
        _ => "bg-secondary"
    };

    private static string JobStatusLabel(QuestionGenerationJobStatus s) => s switch
    {
        QuestionGenerationJobStatus.Running => "Generando",
        QuestionGenerationJobStatus.Queued => "En cola",
        QuestionGenerationJobStatus.Completed => "Completado",
        QuestionGenerationJobStatus.Failed => "Falló",
        _ => s.ToString()
    };

    public void Dispose() => _pollingCts?.Cancel();
}
