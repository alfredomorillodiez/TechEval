@inherits LayoutComponentBase
@inject AuthStateService Auth
@inject NavigationManager Nav

<div class="d-flex min-vh-100">
    @if (Auth.IsAuthenticated && Auth.IsAdmin)
    {
        <!-- Sidebar -->
        <nav class="bg-dark text-white d-flex flex-column p-3" style="width:250px;min-height:100vh;">
            <div class="mb-4 pb-3 border-bottom border-secondary">
                <h6 class="text-white mb-0 fw-bold">TechEval</h6>
                <small class="text-muted">@Auth.UserName</small>
            </div>
            <ul class="nav flex-column gap-1 flex-grow-1">
                <li class="nav-item">
                    <NavLink class="nav-link text-white d-flex align-items-center gap-2 rounded" href="/admin" Match="NavLinkMatch.All">
                        <i class="bi bi-speedometer2"></i> Dashboard
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link text-white d-flex align-items-center gap-2 rounded" href="/admin/questions" Match="NavLinkMatch.Prefix">
                        <i class="bi bi-question-circle"></i> Preguntas
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link text-white d-flex align-items-center gap-2 rounded" href="/admin/pruebas" Match="NavLinkMatch.Prefix">
                        <i class="bi bi-file-earmark-text"></i> Pruebas
                    </NavLink>
                </li>
                <li class="nav-item">
                    <NavLink class="nav-link text-white d-flex align-items-center gap-2 rounded" href="/admin/results" Match="NavLinkMatch.Prefix">
                        <i class="bi bi-bar-chart"></i> Resultados
                    </NavLink>
                </li>
            </ul>
            <div class="border-top border-secondary pt-3">
                <button class="btn btn-outline-secondary btn-sm w-100" @onclick="LogoutAsync">
                    <i class="bi bi-box-arrow-right me-1"></i> Cerrar sesión
                </button>
            </div>
        </nav>
    }

    <div class="flex-grow-1 d-flex flex-column">
        @if (Auth.IsAuthenticated && !Auth.IsAdmin)
        {
            <nav class="navbar navbar-light bg-white border-bottom px-4 py-2">
                <span class="navbar-brand mb-0 h6">TechEval — <span class="text-muted fw-normal">@Auth.UserName</span></span>
                <button class="btn btn-outline-secondary btn-sm" @onclick="LogoutAsync">
                    <i class="bi bi-box-arrow-right me-1"></i> Cerrar sesión
                </button>
            </nav>
        }
        <main class="flex-grow-1 bg-light overflow-auto">
            @Body
        </main>
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
        => await Auth.InitializeAsync();

    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("/login");
    }
}
