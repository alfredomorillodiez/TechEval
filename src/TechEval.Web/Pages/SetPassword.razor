@page "/fijar-contrasena/{Token}"
@using TechEval.Application.DTOs
@using TechEval.Application.Services
@inject ApiService Api
@inject NavigationManager Nav

<PageTitle>Fijar contraseña — TechEval</PageTitle>

<div class="d-flex justify-content-center align-items-center vh-100 bg-light">
    <div class="card border-0 shadow-lg p-4" style="max-width:440px;width:100%;">
        <div class="text-center mb-4">
            <div class="bg-primary bg-opacity-10 rounded-3 d-inline-flex p-3 mb-3">
                <i class="bi bi-key text-primary" style="font-size:2rem;"></i>
            </div>
            <h1 class="h4 mb-0">Fija tu contraseña</h1>
        </div>

        @switch (_state)
        {
            case State.Loading:
                <div class="text-center py-3"><div class="spinner-border text-primary"></div></div>
                break;

            case State.Invalid:
                @* Un solo mensaje para caducado, usado o inexistente: la API tampoco los distingue. *@
                <div class="alert alert-warning mb-0">
                    El enlace no es válido o ha caducado. Pide uno nuevo al administrador.
                </div>
                break;

            case State.Done:
                <div class="alert alert-success">Contraseña fijada. Ya puedes iniciar sesión.</div>
                <a href="/login" class="btn btn-primary w-100">Ir a iniciar sesión</a>
                break;

            default:
                <p class="text-muted small text-center">
                    @_info!.Name · @_info.Email
                </p>

                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="alert alert-danger py-2">@_error</div>
                }

                <div class="mb-3">
                    <label class="form-label">Contraseña</label>
                    <input type="password" class="form-control" @bind="_password" autocomplete="new-password" />
                    <div class="form-text">
                        Entre @PasswordSetupService.MinPasswordLength y @PasswordSetupService.MaxPasswordLength
                        caracteres. Una frase de varias palabras es una buena contraseña.
                    </div>
                </div>
                <div class="mb-4">
                    <label class="form-label">Repite la contraseña</label>
                    <input type="password" class="form-control" @bind="_repeat" autocomplete="new-password"
                           @onkeydown="OnKeyDown" />
                </div>

                <button class="btn btn-primary btn-lg w-100" @onclick="SubmitAsync" disabled="@_busy">
                    @if (_busy) { <span class="spinner-border spinner-border-sm me-2"></span> }
                    Fijar contraseña
                </button>
                break;
        }
    </div>
</div>

@code {
    private enum State { Loading, Invalid, Form, Done }

    [Parameter] public string Token { get; set; } = string.Empty;

    private State _state = State.Loading;
    private PasswordSetupInfoDto? _info;
    private string _password = string.Empty, _repeat = string.Empty;
    private string? _error;
    private bool _busy;

    protected override async Task OnInitializedAsync()
    {
        _info = await Api.CheckPasswordSetupAsync(Token);
        _state = _info is null ? State.Invalid : State.Form;
    }

    private async Task SubmitAsync()
    {
        _error = null;
        if (_password != _repeat) { _error = "Las dos contraseñas no coinciden."; return; }
        if (_password.Length < PasswordSetupService.MinPasswordLength
            || _password.Length > PasswordSetupService.MaxPasswordLength)
        {
            _error = $"La contraseña debe tener entre {PasswordSetupService.MinPasswordLength} " +
                     $"y {PasswordSetupService.MaxPasswordLength} caracteres.";
            return;
        }

        _busy = true;
        var (status, error) = await Api.SetPasswordAsync(new SetPasswordDto(Token, _password));
        _busy = false;

        switch (status)
        {
            case 204: _state = State.Done; break;
            case 404: _state = State.Invalid; break;
            case 429: _error = "Demasiados intentos. Espera un minuto y vuelve a probar."; break;
            default: _error = error ?? "No se pudo fijar la contraseña."; break;
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SubmitAsync();
    }
}
