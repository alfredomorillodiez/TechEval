@page "/prueba/{Token}"
@implements IDisposable
@using TechEval.Application.DTOs
@using TechEval.Domain.Enums
@using Microsoft.JSInterop
@inject ApiService Api
@inject AuthStateService Auth
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>Prueba técnica — TechEval</PageTitle>

@if (_state == ExamState.Validating)
{
    <div class="d-flex justify-content-center align-items-center vh-100">
        <div class="text-center">
            <div class="spinner-border text-primary mb-3" style="width:3rem;height:3rem;"></div>
            <p class="text-muted">Validando enlace de prueba...</p>
        </div>
    </div>
}
else if (_state == ExamState.Invalid)
{
    <div class="d-flex justify-content-center align-items-center vh-100">
        <div class="text-center" style="max-width:450px;">
            <div class="display-1 text-danger mb-3">⚠️</div>
            <h2>Enlace no válido</h2>
            <p class="text-muted">@_errorMessage</p>
        </div>
    </div>
}
else if (_state == ExamState.Welcome)
{
    <div class="d-flex justify-content-center align-items-center min-vh-100 bg-light">
        <div class="card border-0 shadow-lg p-4" style="max-width:500px;width:100%;">
            <div class="text-center mb-4">
                <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex p-3 mb-3">
                    <i class="bi bi-file-earmark-check text-primary" style="font-size:2rem;"></i>
                </div>
                <h2 class="h4">@_sessionInfo!.ExamTitle</h2>
                <p class="text-muted mb-0">Hola, <strong>@_sessionInfo.CandidateName</strong></p>
            </div>
            <ul class="list-unstyled mb-4">
                <li class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-list-check text-primary"></i>
                    <span><strong>@_sessionInfo.Questions.Count</strong> preguntas</span>
                </li>
                <li class="d-flex align-items-center gap-2 mb-2">
                    <i class="bi bi-clock text-primary"></i>
                    <span>Tiempo límite: <strong>@_sessionInfo.TimeLimitMinutes minutos</strong></span>
                </li>
                <li class="d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle text-warning"></i>
                    <span>Una vez iniciada no puedes pausar la prueba.</span>
                </li>
            </ul>
            @* El registro de actividad es un tratamiento de datos del candidato: se informa
               antes de empezar, no después. *@
            <div class="alert alert-secondary small mb-4" role="note">
                <p class="fw-semibold mb-2">
                    <i class="bi bi-shield-check me-1"></i> Durante la prueba se registra:
                </p>
                <ul class="mb-2 ps-3">
                    <li>Cada vez que sales de esta página, y cuánto tiempo estás fuera.</li>
                    <li>Cada vez que pegas texto en una respuesta abierta, con el número de caracteres. El texto pegado no se guarda.</li>
                </ul>
                <p class="mb-2">Las preguntas muestran una marca de agua con tu nombre y tu correo.</p>
                <p class="mb-0">El equipo evaluador ve este registro. El registro no cambia la nota de forma automática.</p>
            </div>
            <button class="btn btn-primary btn-lg w-100" @onclick="StartExam">
                Comenzar prueba <i class="bi bi-arrow-right ms-1"></i>
            </button>
        </div>
    </div>
}
else if (_state == ExamState.InProgress)
{
    @* Marca de agua: no impide la captura, pero la captura identifica a su autor. No recibe
       clics, no se selecciona y el lector de pantalla no la anuncia. *@
    <div class="exam-watermark" aria-hidden="true" style="background-image:url('@WatermarkUrl()')"></div>

    <div class="min-vh-100 bg-light">
        <!-- Header con temporizador -->
        <div class="bg-white shadow-sm sticky-top">
            <div class="container-fluid py-2 px-4 d-flex justify-content-between align-items-center">
                <div>
                    <strong>@_sessionInfo!.ExamTitle</strong>
                    <span class="text-muted ms-2">@_sessionInfo.CandidateName</span>
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span class="text-muted small">@(_currentQuestion + 1)/@_sessionInfo.Questions.Count</span>
                    <div class="badge @TimerClass() fs-6 px-3 py-2">
                        <i class="bi bi-clock me-1"></i> @FormatTimer()
                    </div>
                </div>
            </div>
            <!-- Progress bar -->
            <div class="progress" style="height:4px;border-radius:0;">
                <div class="progress-bar bg-primary" style="width:@((_currentQuestion + 1.0) / _sessionInfo!.Questions.Count * 100)%"></div>
            </div>
        </div>

        <div class="container py-4" style="max-width:750px;">
            @{
                var q = _sessionInfo!.Questions[_currentQuestion];
                var draft = GetDraft(q.QuestionId);
            }
            <div class="card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <div class="d-flex gap-2 mb-3">
                        <span class="badge bg-primary">@(_currentQuestion + 1)</span>
                        <span class="badge @(q.Type == QuestionType.MultipleChoice ? "bg-info" : "bg-warning text-dark")">
                            @(q.Type == QuestionType.MultipleChoice ? "Test" : "Abierta")
                        </span>
                        <span class="badge bg-secondary">@q.Points @(q.Points == 1 ? "punto" : "puntos")</span>
                    </div>
                    <p class="fs-5 mb-4">@q.Text</p>

                    @if (q.Type == QuestionType.MultipleChoice)
                    {
                        @foreach (var answer in q.Answers)
                        {
                            <div class="mb-2">
                                <label class="d-flex align-items-center p-3 rounded border cursor-pointer @(draft?.SelectedAnswerId == answer.Id ? "border-primary bg-primary bg-opacity-10" : "border-light bg-white")"
                                       style="cursor:pointer;">
                                    <input type="radio" name="q@(q.QuestionId)" class="form-check-input me-3"
                                           value="@answer.Id"
                                           checked="@(draft?.SelectedAnswerId == answer.Id)"
                                           @onchange="() => SelectAnswer(q.QuestionId, answer.Id)" />
                                    @answer.Text
                                </label>
                            </div>
                        }
                    }
                    else
                    {
                        <textarea class="form-control" rows="6"
                                  data-question-id="@q.QuestionId"
                                  placeholder="Escribe tu respuesta aquí..."
                                  value="@draft?.OpenAnswer"
                                  @oninput="e => UpdateOpenAnswer(q.QuestionId, e.Value?.ToString())"
                                  @onblur="() => AutoSave(q.QuestionId)"></textarea>
                        <div class="text-muted small mt-1">El campo se guarda automáticamente.</div>
                    }
                </div>
            </div>

            <!-- Navegación -->
            <div class="d-flex justify-content-between">
                <button class="btn btn-outline-secondary" @onclick="PrevQuestion"
                        disabled="@(_currentQuestion == 0)">
                    <i class="bi bi-chevron-left me-1"></i> Anterior
                </button>

                @if (_currentQuestion < _sessionInfo!.Questions.Count - 1)
                {
                    <button class="btn btn-primary" @onclick="NextQuestion">
                        Siguiente <i class="bi bi-chevron-right ms-1"></i>
                    </button>
                }
                else
                {
                    <button class="btn btn-success" @onclick="() => _showConfirm = true">
                        <i class="bi bi-check-lg me-1"></i> Finalizar prueba
                    </button>
                }
            </div>

            <!-- Mini mapa de preguntas -->
            <div class="card border-0 shadow-sm mt-4">
                <div class="card-body p-3">
                    <p class="small text-muted mb-2">Navegación rápida</p>
                    <div class="d-flex flex-wrap gap-1">
                        @for (int i = 0; i < _sessionInfo!.Questions.Count; i++)
                        {
                            var idx = i;
                            var answered = GetDraft(_sessionInfo.Questions[i].QuestionId) is { } d
                                && (d.SelectedAnswerId.HasValue || !string.IsNullOrEmpty(d.OpenAnswer));
                            <button class="btn btn-sm @(idx == _currentQuestion ? "btn-primary" : answered ? "btn-success" : "btn-outline-secondary")"
                                    style="min-width:36px;"
                                    @onclick="() => _currentQuestion = idx">
                                @(idx + 1)
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (_showConfirm)
    {
        <div class="modal d-block" style="background:rgba(0,0,0,0.5);">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-body text-center p-4">
                        <i class="bi bi-question-circle text-warning" style="font-size:3rem;"></i>
                        <h4 class="mt-3">¿Finalizar la prueba?</h4>
                        <p class="text-muted">
                            Has respondido <strong>@_drafts.Count(d => d.SelectedAnswerId.HasValue || !string.IsNullOrEmpty(d.OpenAnswer))</strong>
                            de <strong>@_sessionInfo!.Questions.Count</strong> preguntas.
                        </p>
                        <p class="text-muted small">Esta acción no se puede deshacer.</p>
                    </div>
                    <div class="modal-footer justify-content-center gap-2">
                        <button class="btn btn-outline-secondary" @onclick="() => _showConfirm = false">
                            Continuar prueba
                        </button>
                        <button class="btn btn-success" @onclick="SubmitExamAsync" disabled="@_submitting">
                            @if (_submitting) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            Sí, finalizar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }
}
else if (_state == ExamState.Completed)
{
    <div class="d-flex justify-content-center align-items-center min-vh-100 bg-light">
        <div class="card border-0 shadow-lg p-4 text-center" style="max-width:500px;width:100%;">
            @if (_result!.Status == ExamResultStatus.PendingReview)
            {
                @* Sin puntuación, veredicto ni indicadores de éxito o fracaso: la prueba
                   contiene abiertas que nadie ha corregido todavía. *@
                <div class="display-1 mb-3">📨</div>
                <h2 class="h4 mb-1">Prueba recibida</h2>
                <p class="text-muted mb-4">@_result.ExamTitle</p>

                <div class="p-4 rounded-3 mb-4 bg-primary bg-opacity-10 text-start">
                    <p class="mb-0">
                        Esta prueba incluye preguntas de respuesta abierta que requieren
                        <strong>corrección manual</strong> por parte del equipo evaluador.
                    </p>
                </div>

                <p class="text-muted small">
                    Te enviaremos el resultado por email en cuanto la corrección esté finalizada.
                    Gracias por participar.
                </p>
            }
            else
            {
                var passed = _result.Passed == true;
                <div class="display-1 mb-3">@(passed ? "🎉" : "😔")</div>
                <h2 class="h4 mb-1">@(passed ? "¡Aprobado!" : "No aprobado")</h2>
                <p class="text-muted mb-4">@_result.ExamTitle</p>

                <div class="p-4 rounded-3 mb-4 @(passed ? "bg-success bg-opacity-10" : "bg-danger bg-opacity-10")">
                    <div class="display-4 fw-bold @(passed ? "text-success" : "text-danger")">
                        @_result.ScorePercentage%
                    </div>
                    <div class="text-muted">@_result.ObtainedPoints / @_result.TotalPoints puntos</div>
                </div>

                <p class="text-muted small">
                    Recibirás un email con los resultados. Gracias por participar.
                </p>
            }
            <a class="btn btn-outline-primary" href="/portal">
                <i class="bi bi-list-check me-1"></i> Ver mis pruebas
            </a>
        </div>
    </div>
}

@code {
    [Parameter] public string Token { get; set; } = string.Empty;

    private enum ExamState { Validating, Invalid, Welcome, InProgress, Completed }
    private ExamState _state = ExamState.Validating;

    private ExamSessionInfoDto? _sessionInfo;
    private ExamSubmissionReceiptDto? _result;
    private string _errorMessage = string.Empty;
    private int _currentQuestion = 0;
    private bool _showConfirm, _submitting;

    private List<DraftAnswer> _drafts = new();
    private System.Timers.Timer? _timer;

    // Un retardo por pregunta: el candidato puede saltar entre dos abiertas, y el de una
    // no debe cancelar el de la otra.
    private static readonly TimeSpan AutoSaveDelay = TimeSpan.FromSeconds(2);
    private readonly Dictionary<int, CancellationTokenSource> _autoSaveDelays = new();
    private int _remainingSeconds;

    // El examen mide el tiempo con dos relojes y se queda con el que más ha avanzado.
    // Al cronómetro no le afecta un cambio de hora del sistema. La hora UTC sigue
    // corriendo aunque el equipo se suspenda. Ninguno de los dos puede regalar tiempo.
    private System.Diagnostics.Stopwatch? _clock;
    private DateTime _startedAtUtc;
    private int _secondsAtStart;
    private DotNetObjectReference<TakeExam>? _selfRef;

    // Señales de integridad que no llegaron al servidor. Se reintentan antes de cada señal
    // nueva. Con tope, para que una caída larga de la red no acumule memoria sin límite.
    private const int MaxPendingSignals = 50;
    private readonly Queue<IntegrityEventInputDto> _pendingSignals = new();
    private bool _flushingSignals;
    // Una vuelta solo tiene sentido después de una salida registrada. Sin esto, salir en la
    // bienvenida y volver ya dentro de la prueba enviaría una vuelta sin salida.
    private bool _awaySignalled;

    protected override async Task OnInitializedAsync()
    {
        var validation = await Api.ValidateTokenAsync(Token);
        if (validation is null || !validation.IsValid)
        {
            _errorMessage = validation?.Error ?? "Token inválido.";
            _state = ExamState.Invalid;
            return;
        }

        if (!string.IsNullOrEmpty(validation.AuthToken))
            await Auth.LoginAsync(validation.AuthToken, validation.CandidateName ?? string.Empty, isAdmin: false);

        // El backend devuelve SessionId cuando la prueba ya estaba empezada. En ese caso no
        // hay bienvenida que mostrar: el candidato vuelve de una recarga y espera continuar.
        var resuming = validation.SessionId is not null;

        var session = await Api.StartSessionAsync(Token);
        if (session is null) { _state = ExamState.Invalid; _errorMessage = "Error al iniciar sesión."; return; }

        _sessionInfo = session;
        // El tiempo lo mide el servidor. Inicializarlo con TimeLimitMinutes daría una prueba
        // nueva completa en cada recarga.
        _remainingSeconds = session.RemainingSeconds;
        // Los relojes locales arrancan en el mismo instante que cuenta el servidor.
        _secondsAtStart = _remainingSeconds;
        _clock = System.Diagnostics.Stopwatch.StartNew();
        _startedAtUtc = DateTime.UtcNow;
        _drafts = session.Questions.Select(q => new DraftAnswer { QuestionId = q.QuestionId }).ToList();
        RestoreSavedAnswers(session);

        if (!resuming) { _state = ExamState.Welcome; return; }

        if (_remainingSeconds <= 0)
        {
            // Volvió fuera de plazo: se cierra con lo que tenga guardado, sin preguntar.
            _state = ExamState.InProgress;
            await SubmitExamAsync();
            return;
        }

        StartExam();
    }

    /// <summary>
    /// Vuelca en los borradores lo que el candidato ya tenía guardado. Sin esto, el envío
    /// posterior mandaría respuestas vacías y borraría su trabajo.
    /// </summary>
    private void RestoreSavedAnswers(ExamSessionInfoDto session)
    {
        foreach (var saved in session.SavedAnswers)
        {
            var draft = GetDraft(saved.QuestionId);
            if (draft is null) continue;
            draft.SelectedAnswerId = saved.SelectedAnswerId;
            draft.OpenAnswer = saved.OpenAnswer;
        }
    }

    private void StartExam()
    {
        _state = ExamState.InProgress;

        // Este temporizador solo refresca la pantalla. El tiempo restante sale de los
        // relojes. El navegador frena o para el temporizador si la ventana está oculta,
        // así que descontar un segundo por aviso regalaría tiempo al candidato.
        _timer = new System.Timers.Timer(1000);
        _timer.Elapsed += async (_, _) => await OnTimerTickAsync();
        _timer.Start();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        _selfRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("examTimer.register", _selfRef);
        await JS.InvokeVoidAsync("examIntegrity.register", _selfRef);
    }

    // ---------- Señales de integridad ----------
    //
    // Las captura exam-integrity.js y se envían desde aquí, porque el JWT lo gestiona
    // ApiService. Ninguna interrumpe la prueba ni muestra nada al candidato.

    [JSInvokable]
    public Task OnPageLeft()
    {
        if (_state != ExamState.InProgress || _awaySignalled) return Task.CompletedTask;
        _awaySignalled = true;
        return RecordSignalAsync(new IntegrityEventInputDto(
            IntegrityEventType.PageLeft, CurrentQuestionId(), null, null));
    }

    [JSInvokable]
    public Task OnPageReturned(int awaySeconds)
    {
        if (_state != ExamState.InProgress || !_awaySignalled) return Task.CompletedTask;
        _awaySignalled = false;
        return RecordSignalAsync(new IntegrityEventInputDto(
            IntegrityEventType.PageReturned, CurrentQuestionId(), awaySeconds, null));
    }

    [JSInvokable]
    public Task OnPaste(int questionId, int pastedChars)
    {
        if (_state != ExamState.InProgress) return Task.CompletedTask;
        return RecordSignalAsync(new IntegrityEventInputDto(
            IntegrityEventType.Paste, questionId, null, pastedChars));
    }

    private int? CurrentQuestionId()
        => _sessionInfo is { } s && _currentQuestion < s.Questions.Count
            ? s.Questions[_currentQuestion].QuestionId
            : null;

    private async Task RecordSignalAsync(IntegrityEventInputDto signal)
    {
        _pendingSignals.Enqueue(signal);
        while (_pendingSignals.Count > MaxPendingSignals) _pendingSignals.Dequeue();

        // Un solo envío a la vez, en orden: una salida pendiente tiene que llegar antes que
        // su vuelta. La señal que llega mientras otro envío está en vuelo espera en la cola.
        if (_flushingSignals) return;
        _flushingSignals = true;
        try
        {
            while (_pendingSignals.TryPeek(out var next))
            {
                if (!await Api.RecordIntegrityEventAsync(_sessionInfo!.SessionId, next)) break;
                _pendingSignals.Dequeue();
            }
        }
        finally
        {
            _flushingSignals = false;
        }
    }

    /// <summary>
    /// Fondo de la marca de agua: un SVG con el nombre y el correo, girado y repetido.
    /// El texto se escapa para XML y la URL se codifica entera, así que un nombre con
    /// comillas o signos no rompe el SVG ni el atributo style.
    /// </summary>
    private string WatermarkUrl()
    {
        var name = System.Security.SecurityElement.Escape(_sessionInfo?.CandidateName ?? string.Empty);
        var email = System.Security.SecurityElement.Escape(_sessionInfo?.CandidateEmail ?? string.Empty);
        var svg =
            "<svg xmlns='http://www.w3.org/2000/svg' width='360' height='220'>" +
            "<g transform='rotate(-30 180 110)' font-family='sans-serif' font-size='15' " +
            "fill='rgba(0,0,0,0.09)' text-anchor='middle'>" +
            $"<text x='180' y='104'>{name}</text>" +
            $"<text x='180' y='126'>{email}</text>" +
            "</g></svg>";
        return "data:image/svg+xml," + Uri.EscapeDataString(svg);
    }

    /// <summary>
    /// Lo llama el navegador cuando la ventana vuelve a estar a la vista. Recalcula el
    /// tiempo sin esperar al temporizador, que el navegador pudo dejar parado.
    /// </summary>
    [JSInvokable]
    public async Task RefreshTimer()
    {
        if (_state != ExamState.InProgress) return;
        await OnTimerTickAsync();
    }

    private int ElapsedSeconds()
    {
        var byStopwatch = _clock?.Elapsed.TotalSeconds ?? 0;
        var byWallClock = (DateTime.UtcNow - _startedAtUtc).TotalSeconds;
        return (int)Math.Round(Math.Max(byStopwatch, byWallClock));
    }

    private async Task OnTimerTickAsync()
    {
        _remainingSeconds = Math.Max(0, _secondsAtStart - ElapsedSeconds());

        if (_remainingSeconds == 0)
        {
            _timer?.Stop();
            await SubmitExamAsync();
            return;
        }

        await InvokeAsync(StateHasChanged);
    }

    private void NextQuestion() { if (_currentQuestion < _sessionInfo!.Questions.Count - 1) _currentQuestion++; }
    private void PrevQuestion() { if (_currentQuestion > 0) _currentQuestion--; }

    private void SelectAnswer(int questionId, int answerId)
    {
        var draft = GetDraft(questionId);
        if (draft is null) return;
        draft.SelectedAnswerId = answerId;
        _ = AutoSave(questionId);
    }

    private void UpdateOpenAnswer(int questionId, string? text)
    {
        var draft = GetDraft(questionId);
        if (draft is null) return;
        draft.OpenAnswer = text;
        ScheduleAutoSave(questionId);
    }

    // Antes solo se guardaba al perder el foco: cerrar el navegador mientras se escribía,
    // sin salir del campo, perdía la respuesta entera. Guardar en cada pulsación sería una
    // llamada por carácter, así que el envío espera a que el candidato pare de teclear.
    // El `@onblur` se conserva: cubre a quien escribe y salta de campo antes del retardo.
    private void ScheduleAutoSave(int questionId)
    {
        CancelPendingAutoSave(questionId);

        var cts = new CancellationTokenSource();
        _autoSaveDelays[questionId] = cts;
        _ = DelayThenAutoSaveAsync(questionId, cts.Token);
    }

    private async Task DelayThenAutoSaveAsync(int questionId, CancellationToken ct)
    {
        try
        {
            await Task.Delay(AutoSaveDelay, ct);
            await AutoSave(questionId);
        }
        catch (OperationCanceledException)
        {
            // Llegó otra pulsación antes de vencer el retardo. Guarda ella.
        }
    }

    private void CancelPendingAutoSave(int questionId)
    {
        if (!_autoSaveDelays.Remove(questionId, out var pending)) return;
        pending.Cancel();
        pending.Dispose();
    }

    private async Task AutoSave(int questionId)
    {
        CancelPendingAutoSave(questionId);

        var draft = GetDraft(questionId);
        if (draft is null) return;

        // Un rechazo por plazo vencido no se trata aquí a propósito. `SaveAnswerAsync` no
        // lanza ante un 409, y el borrador sigue en pantalla: el envío final puntúa con lo
        // último que entró en plazo. Borrar el texto castigaría al candidato dos veces.
        await Api.SaveAnswerAsync(_sessionInfo!.SessionId, new SubmitAnswerDto(
            questionId, draft.SelectedAnswerId, draft.OpenAnswer));
    }

    private async Task SubmitExamAsync()
    {
        // El temporizador puede llegar a cero con el envío manual todavía en vuelo. El
        // servidor ya tolera el duplicado, pero la petición que no sale es mejor que la
        // que se descarta.
        if (_submitting) return;

        _showConfirm = false;
        _submitting = true;
        _timer?.Stop();

        // Un retardo pendiente escribiría en una sesión ya cerrada. El cuerpo del envío
        // lleva los borradores completos, así que no se pierde nada al cancelarlos.
        foreach (var id in _autoSaveDelays.Keys.ToList()) CancelPendingAutoSave(id);

        var answers = _drafts.Select(d => new SubmitAnswerDto(
            d.QuestionId, d.SelectedAnswerId, d.OpenAnswer)).ToList();

        _result = await Api.SubmitExamAsync(new SubmitExamDto(_sessionInfo!.SessionId, answers));
        _state = ExamState.Completed;
        _submitting = false;
    }

    private DraftAnswer? GetDraft(int questionId)
        => _drafts.FirstOrDefault(d => d.QuestionId == questionId);

    private string FormatTimer()
    {
        var t = TimeSpan.FromSeconds(_remainingSeconds);
        return $"{(int)t.TotalMinutes:D2}:{t.Seconds:D2}";
    }

    private string TimerClass()
    {
        if (_remainingSeconds < 60) return "bg-danger";
        if (_remainingSeconds < 300) return "bg-warning text-dark";
        return "bg-primary";
    }

    public void Dispose()
    {
        _timer?.Stop();
        _timer?.Dispose();
        _clock?.Stop();

        // No esperamos a que termine: Dispose no admite await.
        _ = JS.InvokeVoidAsync("examTimer.unregister");
        _ = JS.InvokeVoidAsync("examIntegrity.unregister");
        _selfRef?.Dispose();

        // Sin esto, salir de la página con un retardo en vuelo dejaría una llamada que
        // escribe en una sesión que el candidato ya abandonó.
        foreach (var pending in _autoSaveDelays.Values)
        {
            pending.Cancel();
            pending.Dispose();
        }
        _autoSaveDelays.Clear();
    }

    private class DraftAnswer
    {
        public int QuestionId { get; set; }
        public int? SelectedAnswerId { get; set; }
        public string? OpenAnswer { get; set; }
    }
}
