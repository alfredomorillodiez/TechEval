@page "/admin/categorias"
@implements IDisposable
@using TechEval.Application
@using TechEval.Application.DTOs
@using TechEval.Application.Services
@inject ApiService Api
@inject NavigationManager Nav
@inject AuthStateService Auth
@inject ListState Lists

<PageTitle>Categorías — TechEval</PageTitle>

@* Antes dar de alta una tecnología (por ejemplo «Kubernetes») pedía SQL o llamar a la API a mano. *@
<div class="container-lg py-4">
    <div class="d-flex justify-content-between align-items-center mb-4 gap-3">
        <h1 class="h3 mb-0">Categorías</h1>
        <button class="btn btn-primary" @onclick="OpenCreate">
            <i class="bi bi-plus-lg me-1"></i> Nueva categoría
        </button>
    </div>

    @if (!string.IsNullOrEmpty(_notice))
    {
        <div class="alert @_noticeClass alert-dismissible py-2" role="alert">
            @_notice
            <button type="button" class="btn-close" aria-label="Cerrar" @onclick="() => _notice = string.Empty"></button>
        </div>
    }

    @if (_loading)
    {
        <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
    }
    else if (_loadFailed)
    {
        <LoadError What="las categorías" OnRetry="LoadAsync" />
    }
    else
    {
        <div class="row g-2 mb-3">
            <div class="col-md-6">
                <input class="form-control" type="search" placeholder="Buscar por nombre o descripción…"
                       aria-label="Buscar categorías" @bind="_search" @bind:event="oninput" />
            </div>
            <div class="col-md-auto d-flex align-items-center text-muted small">
                Mostrando <strong class="mx-1">@Displayed.Count</strong> de @_all.Count categorías
            </div>
        </div>

        @if (Displayed.Count == 0)
        {
            <div class="text-center text-muted py-5">
                @(_all.Count == 0 ? "Todavía no hay categorías." : "Ninguna categoría coincide con la búsqueda.")
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <SortHeader Key="name" State="_sort" OnSort="SortBy" Class="ps-3">Nombre</SortHeader>
                                <SortHeader Key="description" State="_sort" OnSort="SortBy">Descripción</SortHeader>
                                <SortHeader Key="questions" State="_sort" OnSort="SortBy" Class="text-end">Preguntas activas</SortHeader>
                                <SortHeader Key="status" State="_sort" OnSort="SortBy">Estado</SortHeader>
                                <th class="text-end pe-3">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Displayed)
                            {
                                <tr class="@(c.IsActive ? "" : "text-muted")">
                                    <td class="ps-3 fw-semibold">@c.Name</td>
                                    <td>@c.Description</td>
                                    <td class="text-end">@c.QuestionCount</td>
                                    <td>
                                        <span class="badge @(c.IsActive ? "bg-success" : "bg-secondary")">
                                            @(c.IsActive ? "Activa" : "Desactivada")
                                        </span>
                                    </td>
                                    <td class="text-end pe-3 text-nowrap">
                                        @if (_confirmDeactivate == c.Id)
                                        {
                                            <span class="small me-1">¿Dar de baja?</span>
                                            <button class="btn btn-sm btn-danger me-1" disabled="@_busy"
                                                    @onclick="() => DeactivateAsync(c)">Confirmar</button>
                                            <button class="btn btn-sm btn-outline-secondary" @onclick="() => _confirmDeactivate = null">No</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => OpenEdit(c)">
                                                <i class="bi bi-pencil"></i> Editar
                                            </button>
                                            @if (c.IsActive)
                                            {
                                                <button class="btn btn-sm btn-outline-danger" @onclick="() => _confirmDeactivate = c.Id">
                                                    Dar de baja
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-outline-success" disabled="@_busy"
                                                        @onclick="() => ReactivateAsync(c)">
                                                    Reactivar
                                                </button>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <p class="text-muted small mt-2">
                Una categoría dada de baja no se ofrece en los formularios ni aporta preguntas a las pruebas nuevas.
                Sus preguntas y los resultados anteriores se conservan.
            </p>
        }
    }
</div>

@if (_editing)
{
    <div class="modal d-block" style="background: rgba(0,0,0,0.5);" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(_editId is null ? "Nueva categoría" : "Editar categoría")</h5>
                    <button type="button" class="btn-close" aria-label="Cerrar" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    @* El mensaje del servidor (nombre repetido, demasiado largo) sale aquí y no cierra el diálogo. *@
                    @if (!string.IsNullOrEmpty(_modalError)) { <div class="alert alert-danger py-2" role="alert">@_modalError</div> }
                    <div class="mb-3">
                        <label class="form-label" for="category-name">Nombre *</label>
                        <input id="category-name" class="form-control" maxlength="@CategoryService.NameMaxLength" @bind="_name" />
                    </div>
                    <div class="mb-0">
                        <label class="form-label" for="category-description">Descripción</label>
                        <textarea id="category-description" class="form-control" rows="3"
                                  maxlength="@CategoryService.DescriptionMaxLength" @bind="_description"></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" @onclick="CloseModal">Cancelar</button>
                    <button class="btn btn-primary" @onclick="SaveAsync" disabled="@_busy">
                        @if (_busy) { <span class="spinner-border spinner-border-sm me-2"></span> }
                        Guardar
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private const string StateKey = "categories";

    private bool _loading = true, _loadFailed, _busy, _editing;
    private List<CategoryDto> _all = new();
    private string _search = string.Empty;
    private readonly SortState _sort = new() { Key = "name" };
    private int? _confirmDeactivate;

    private int? _editId;
    private string _name = string.Empty, _description = string.Empty, _modalError = string.Empty;
    private string _notice = string.Empty, _noticeClass = "alert-success";

    private sealed record Saved(string Search, SortState Sort);

    private static readonly IReadOnlyDictionary<string, Func<CategoryDto, object?>> Columns =
        new Dictionary<string, Func<CategoryDto, object?>>
        {
            ["name"] = c => c.Name,
            ["description"] = c => c.Description,
            ["questions"] = c => c.QuestionCount,
            ["status"] = c => c.IsActive
        };

    private List<CategoryDto> Displayed => ListSort.Apply(
            _all.Where(c => string.IsNullOrWhiteSpace(_search)
                || c.Name.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase)
                || c.Description.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase)),
            _sort, Columns)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        await Auth.InitializeAsync();
        if (!Auth.IsAdmin) { Nav.NavigateTo(Auth.Home); return; }

        if (Lists.Get<Saved>(StateKey) is { } saved)
        {
            _search = saved.Search;
            _sort.Key = saved.Sort.Key;
            _sort.Descending = saved.Sort.Descending;
        }

        await LoadAsync();
    }

    // El estado se guarda al salir, para recuperarlo al volver (por ejemplo, desde el detalle).
    public void Dispose() => Lists.Set(StateKey, new Saved(_search, _sort.Clone()));

    private async Task LoadAsync()
    {
        _loading = true;
        // Todas, también las desactivadas: esta pantalla es donde se reactivan.
        var all = await Api.GetCategoriesAsync(includeInactive: true);
        _loadFailed = all is null;
        if (all is not null) _all = all;
        _loading = false;
    }

    private void SortBy(string key) => _sort.Toggle(key);

    private void OpenCreate()
    {
        _editId = null;
        _name = _description = _modalError = string.Empty;
        _editing = true;
    }

    private void OpenEdit(CategoryDto c)
    {
        _editId = c.Id;
        _name = c.Name;
        _description = c.Description;
        _modalError = string.Empty;
        _editing = true;
    }

    private void CloseModal() => _editing = false;

    private async Task SaveAsync()
    {
        _modalError = string.Empty;
        if (string.IsNullOrWhiteSpace(_name)) { _modalError = "El nombre de la categoría es obligatorio."; return; }

        _busy = true;
        var (saved, _, error) = _editId is int id
            ? await Api.UpdateCategoryAsync(id, new UpdateCategoryDto(_name, _description))
            : await Api.CreateCategoryAsync(new CreateCategoryDto(_name, _description));
        _busy = false;

        if (saved is null)
        {
            _modalError = error ?? "No se pudo guardar la categoría. Comprueba la conexión e inténtalo de nuevo.";
            return;
        }

        _editing = false;
        Notice($"Categoría «{saved.Name}» guardada.", "alert-success");
        await LoadAsync();
    }

    private async Task DeactivateAsync(CategoryDto c)
    {
        _confirmDeactivate = null;
        _busy = true;
        var ok = await Api.DeleteCategoryAsync(c.Id);
        _busy = false;

        if (!ok) { Notice($"No se pudo dar de baja «{c.Name}». Inténtalo de nuevo.", "alert-danger"); return; }
        Notice($"Categoría «{c.Name}» dada de baja.", "alert-success");
        await LoadAsync();
    }

    private async Task ReactivateAsync(CategoryDto c)
    {
        _busy = true;
        var (updated, _, error) = await Api.UpdateCategoryAsync(c.Id, new UpdateCategoryDto(c.Name, c.Description, IsActive: true));
        _busy = false;

        if (updated is null) { Notice(error ?? $"No se pudo reactivar «{c.Name}».", "alert-danger"); return; }
        Notice($"Categoría «{c.Name}» reactivada.", "alert-success");
        await LoadAsync();
    }

    private void Notice(string text, string css) { _notice = text; _noticeClass = css; }
}
