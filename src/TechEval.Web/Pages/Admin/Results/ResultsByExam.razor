@page "/admin/results/prueba/{ExamId:int}"
@implements IDisposable
@using TechEval.Application
@using TechEval.Application.DTOs
@using TechEval.Domain.Common
@using TechEval.Domain.Enums
@inject ApiService Api
@inject NavigationManager Nav
@inject AuthStateService Auth
@inject ListState Lists

<PageTitle>Estadísticas de la prueba — TechEval</PageTitle>

<div class="container-fluid py-4">

    <div class="d-flex align-items-center gap-3 mb-4">
        <a href="/admin/results" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <p class="text-muted small mb-0">Estadísticas de la prueba</p>
            <h1 class="h3 mb-0">@(_stats?.ExamTitle ?? $"Prueba #{ExamId}")</h1>
        </div>
    </div>

    @if (_firstLoad)
    {
        <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
    }
    else if (_stats is null)
    {
        <LoadError What="los resultados de esta prueba" OnRetry="LoadAllAsync" />
    }
    else if (_stats.Total == 0)
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>
            Esta prueba aún no tiene resultados registrados.
        </div>
    }
    else
    {
        <!-- KPIs: salen de todos los resultados de la prueba, no cambian con los filtros -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-md-4 col-xl">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center">
                        <p class="text-muted small mb-1">Candidatos</p>
                        <p class="h2 fw-bold mb-0">@_stats.Total</p>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl">
                <div class="card border-start border-success border-3 shadow-sm h-100">
                    <div class="card-body text-center">
                        <p class="text-muted small mb-1">Aprobados</p>
                        <p class="h2 fw-bold text-success mb-0">@_stats.Passed</p>
                        <p class="text-muted small mb-0">@(_stats.Reviewed > 0 ? $"{_stats.PassRate}%" : "—")</p>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl">
                <div class="card border-start border-danger border-3 shadow-sm h-100">
                    <div class="card-body text-center">
                        <p class="text-muted small mb-1">Reprobados</p>
                        <p class="h2 fw-bold text-danger mb-0">@(_stats.Reviewed - _stats.Passed)</p>
                        <p class="text-muted small mb-0">@(_stats.Reviewed > 0 ? $"{100 - _stats.PassRate}%" : "—")</p>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl">
                <div class="card border-start border-warning border-3 shadow-sm h-100">
                    <div class="card-body text-center">
                        @* Aparte de los reprobados: un pendiente no está reprobado, solo sin corregir. *@
                        <p class="text-muted small mb-1">Pendientes</p>
                        <p class="h2 fw-bold text-warning mb-0">@_stats.Pending</p>
                        <p class="text-muted small mb-0">sin corregir</p>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl">
                <div class="card border-start border-primary border-3 shadow-sm h-100">
                    <div class="card-body text-center">
                        <p class="text-muted small mb-1">Nota media</p>
                        <p class="h2 fw-bold text-primary mb-0">@_stats.AverageScore<span class="fs-6 fw-normal">%</span></p>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center">
                        <p class="text-muted small mb-1">Nota máxima</p>
                        <p class="h2 fw-bold mb-0">@_stats.MaxScore<span class="fs-6 fw-normal text-muted">%</span></p>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-4 col-xl">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body text-center">
                        <p class="text-muted small mb-1">Nota mínima</p>
                        <p class="h2 fw-bold mb-0">@_stats.MinScore<span class="fs-6 fw-normal text-muted">%</span></p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Distribución de notas -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-0 pt-3">
                <h6 class="mb-0 fw-semibold">Distribución de notas</h6>
            </div>
            <div class="card-body">
                @for (var b = 0; b < Buckets.Length; b++)
                {
                    var count = _stats.Distribution.ElementAtOrDefault(b);
                    var pct = _stats.Total > 0 ? (double)count / _stats.Total * 100 : 0;
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <span class="text-muted small text-end" style="min-width:5rem;">@Buckets[b].Label</span>
                        <div class="flex-grow-1 bg-light rounded" style="height:22px;position:relative;">
                            <div class="rounded @Buckets[b].Color"
                                 style="height:100%;width:@((int)pct)%;transition:width .4s;"></div>
                        </div>
                        <span class="small fw-semibold" style="min-width:4rem;">
                            @count cand. <span class="text-muted fw-normal">(@((int)pct)%)</span>
                        </span>
                    </div>
                }
            </div>
        </div>

        <!-- Filtros -->
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body py-3">
                <div class="row g-2 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold mb-1">Candidato / Email</label>
                        <input class="form-control form-control-sm" placeholder="Buscar nombre o email..."
                               value="@_fSearch" @oninput="OnSearchInput" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-semibold mb-1">Resultado</label>
                        <select class="form-select form-select-sm" @bind="_fPassed" @bind:after="OnFilterChanged">
                            <option value="">Todos</option>
                            <option value="true">Aprobado</option>
                            <option value="false">Reprobado</option>
                            <option value="pending">Pendiente de corrección</option>
                        </select>
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="form-label small fw-semibold mb-1">Nota mínima (%)</label>
                        <input type="number" class="form-control form-control-sm" min="0" max="100"
                               @bind="_fScoreMin" @bind:after="OnFilterChanged" />
                    </div>
                    <div class="col-6 col-md-2">
                        <label class="form-label small fw-semibold mb-1">Nota máxima (%)</label>
                        <input type="number" class="form-control form-control-sm" min="0" max="100"
                               @bind="_fScoreMax" @bind:after="OnFilterChanged" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-semibold mb-1">Fecha desde</label>
                        <input type="date" class="form-control form-control-sm"
                               @bind="_fDateFrom" @bind:after="OnFilterChanged" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label small fw-semibold mb-1">Fecha hasta</label>
                        <input type="date" class="form-control form-control-sm"
                               @bind="_fDateTo" @bind:after="OnFilterChanged" />
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button class="btn btn-outline-secondary btn-sm w-100" @onclick="ClearFilters">
                            <i class="bi bi-x-circle me-1"></i>Limpiar
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabla -->
        @if (_rowsFailed)
        {
            <LoadError What="los resultados de esta prueba" OnRetry="LoadRowsAsync" />
        }
        else
        {
            <div class="card border-0 shadow-sm">
                <div class="card-body p-0 @(_busy ? "opacity-50" : "")" aria-busy="@(_busy ? "true" : "false")">
                    @if (!_rows.Any())
                    {
                        <div class="text-center text-muted py-5">
                            <i class="bi bi-funnel fs-1 d-block mb-2"></i>
                            No hay resultados que coincidan con los filtros.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-3">#</th>
                                        <SortHeader Key="candidate" State="_sort" OnSort="SortBy">Candidato</SortHeader>
                                        <SortHeader Key="score" State="_sort" OnSort="SortBy" Style="min-width:180px;">Puntuación</SortHeader>
                                        <SortHeader Key="outcome" State="_sort" OnSort="SortBy">Resultado</SortHeader>
                                        <SortHeader Key="date" State="_sort" OnSort="SortBy">Fecha</SortHeader>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var (r, i) in _rows.Select((r, i) => (r, _page.FirstRow + i)))
                                    {
                                        <tr>
                                            <td class="ps-3 text-muted small">@i</td>
                                            <td>
                                                <div class="fw-semibold">@r.CandidateName</div>
                                                <div class="text-muted small">@r.CandidateEmail</div>
                                            </td>
                                            <td>
                                                @if (r.Status == ExamResultStatus.PendingReview)
                                                {
                                                    <span class="text-muted small">Sin corregir</span>
                                                }
                                                else
                                                {
                                                    <div class="d-flex align-items-center gap-2">
                                                        <div class="progress flex-grow-1" style="height:8px;">
                                                            <div class="progress-bar @(r.Passed == true ? "bg-success" : "bg-danger")"
                                                                 style="width:@r.ScorePercentage%"></div>
                                                        </div>
                                                        <span class="fw-bold" style="min-width:3.5rem;">@r.ScorePercentage%</span>
                                                    </div>
                                                }
                                            </td>
                                            <td>
                                                @if (r.Status == ExamResultStatus.PendingReview)
                                                {
                                                    <a href="/admin/results/pending" class="badge bg-secondary text-decoration-none">
                                                        <i class="bi bi-hourglass-split me-1"></i> Pendiente de corrección
                                                    </a>
                                                }
                                                else
                                                {
                                                    <span class="badge @(r.Passed == true ? "bg-success" : "bg-danger")">
                                                        @(r.Passed == true ? "Aprobado" : "Reprobado")
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-muted small text-nowrap">
                                                @r.CompletedAt.ToLocalTime().ToString("dd/MM/yyyy")<br />
                                                <span style="font-size:.78rem;">@r.CompletedAt.ToLocalTime().ToString("HH:mm")</span>
                                            </td>
                                            <td class="text-end pe-3">
                                                <a href="/admin/results/@r.Id" class="btn btn-sm btn-outline-primary">
                                                    Ver detalle
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>

            <Pager State="_page" Noun="resultados" OnPage="GoToPageAsync" OnPageSize="SetPageSizeAsync" />
        }
    }
</div>

@code {
    [Parameter] public int ExamId { get; set; }

    private ResultStatsDto? _stats;
    private List<ExamResultSummaryDto> _rows = new();
    private bool _firstLoad = true, _busy, _rowsFailed;

    // Los seis tramos, en el orden que devuelve la API.
    private static readonly (string Label, string Color)[] Buckets =
    {
        ("0 – 49%", "bg-danger"),
        ("50 – 59%", "bg-warning"),
        ("60 – 69%", "bg-warning"),
        ("70 – 79%", "bg-info"),
        ("80 – 89%", "bg-primary"),
        ("90 – 100%", "bg-success"),
    };

    // Filtros
    private string _fSearch = string.Empty;
    private string _fPassed = string.Empty;
    private int? _fScoreMin;
    private int? _fScoreMax;
    private DateTime? _fDateFrom;
    private DateTime? _fDateTo;

    // Cada prueba tiene su propio estado: los filtros de una no se heredan en otra.
    private static string KeyFor(int examId) => $"results-exam-{examId}";

    // Por defecto, el ranking: de mayor a menor nota (lo que hacía antes el listado fijo).
    private readonly SortState _sort = new() { Key = "score", Descending = true };
    private readonly PageState _page = new();
    private readonly ListLoader _loader = new();

    private sealed record Saved(
        string Search, string Passed, int? Min, int? Max, DateTime? From, DateTime? To,
        SortState Sort, int Page, int PageSize);

    private Saved Snapshot() => new(
        _fSearch, _fPassed, _fScoreMin, _fScoreMax, _fDateFrom, _fDateTo,
        _sort.Clone(), _page.Page, _page.PageSize);

    public void Dispose()
    {
        if (_loadedExamId != -1) Lists.Set(KeyFor(_loadedExamId), Snapshot());
        _loader.Dispose();
    }

    private bool _authorized;
    private int _loadedExamId = -1;

    protected override async Task OnInitializedAsync()
    {
        await Auth.InitializeAsync();
        if (!Auth.IsAdmin) { Nav.NavigateTo(Auth.Home); return; }
        _authorized = true;
    }

    // Pasar de los resultados de una prueba a los de otra reutiliza el componente: sin esto, la
    // segunda pantalla mostraba los datos y los filtros de la primera. Cada cambio de prueba guarda
    // el estado de la anterior, restaura el de la nueva (o los valores por defecto) y recarga.
    protected override async Task OnParametersSetAsync()
    {
        if (!_authorized || _loadedExamId == ExamId) return;

        if (_loadedExamId != -1) Lists.Set(KeyFor(_loadedExamId), Snapshot());
        _loadedExamId = ExamId;

        _fSearch = _fPassed = string.Empty;
        _fScoreMin = _fScoreMax = null;
        _fDateFrom = _fDateTo = null;
        _sort.Key = "score"; _sort.Descending = true;
        _page.Page = 1; _page.PageSize = PageQuery.DefaultPageSize;

        if (Lists.Get<Saved>(KeyFor(ExamId)) is { } saved)
        {
            _fSearch = saved.Search; _fPassed = saved.Passed;
            _fScoreMin = saved.Min; _fScoreMax = saved.Max; _fDateFrom = saved.From; _fDateTo = saved.To;
            _sort.Key = saved.Sort.Key; _sort.Descending = saved.Sort.Descending;
            _page.Page = saved.Page; _page.PageSize = saved.PageSize;
        }

        await LoadAllAsync();
    }

    private async Task LoadAllAsync()
    {
        _firstLoad = true;
        _stats = null;
        var stats = Api.GetResultStatsAsync(ExamId);
        await LoadRowsAsync();
        _stats = await stats;
        _firstLoad = false;
    }

    private async Task LoadRowsAsync()
    {
        _busy = true;
        var examId = ExamId;
        var (from, to) = DayRange.ToUtc(_fDateFrom, _fDateTo, TimeZoneInfo.Local);
        var filter = new ResultFilter(null, OutcomeValue(), _fScoreMin, _fScoreMax, from, to);

        // Si la página guardada ya no existe, se pide la última una sola vez.
        for (var attempt = 0; attempt < 2; attempt++)
        {
            var again = false;
            var query = _page.ToQuery(_fSearch, _sort);
            var applied = await _loader.LoadAsync(() => Api.GetResultsByExamPageAsync(examId, query, filter), r =>
            {
                _rowsFailed = r is null;
                if (r is null) return;

                var beyond = _page.IsBeyondEnd(r);
                _page.Apply(r);
                if (beyond) { _page.GoToLast(); again = true; return; }
                _rows = r.Items.ToList();
            });

            if (!applied) return;
            if (!again) break;
        }

        _busy = false;
        StateHasChanged();
    }

    private string? OutcomeValue() => _fPassed switch
    {
        "true" => "passed",
        "false" => "failed",
        "pending" => "pending",
        _ => null
    };

    // Buscar, filtrar u ordenar vuelve a la primera página.
    private async Task OnFilterChanged()
    {
        _page.Reset();
        await LoadRowsAsync();
    }

    private Task OnSearchInput(ChangeEventArgs e)
    {
        _fSearch = e.Value?.ToString() ?? string.Empty;
        _page.Reset();
        _ = _loader.DebounceAsync(LoadRowsAsync);
        return Task.CompletedTask;
    }

    private async Task SortBy(string key)
    {
        _sort.Toggle(key);
        _page.Reset();
        await LoadRowsAsync();
    }

    private async Task GoToPageAsync(int page)
    {
        _page.Page = page;
        await LoadRowsAsync();
    }

    private async Task SetPageSizeAsync(int size)
    {
        _page.SetPageSize(size);
        await LoadRowsAsync();
    }

    private async Task ClearFilters()
    {
        _fSearch = string.Empty;
        _fPassed = string.Empty;
        _fScoreMin = null;
        _fScoreMax = null;
        _fDateFrom = null;
        _fDateTo = null;
        _page.Reset();
        await LoadRowsAsync();
    }
}
