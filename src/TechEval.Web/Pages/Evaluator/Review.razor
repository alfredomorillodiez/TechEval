@page "/evaluacion/{Id:int}"
@using TechEval.Application.DTOs
@inject ApiService Api
@inject NavigationManager Nav
@inject AuthStateService Auth

<PageTitle>Corregir — TechEval</PageTitle>

<div class="container-lg py-4">
    <div class="d-flex align-items-center gap-3 mb-4">
        <a href="/evaluacion" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h1 class="h3 mb-0 flex-grow-1">Corregir preguntas abiertas</h1>
    </div>

    @if (_loading)
    {
        <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
    }
    else if (_outcome is not null)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <div class="display-6 fw-bold @(_outcome.Passed ? "text-success" : "text-danger")">
                    @_outcome.ScorePercentage%
                </div>
                <p class="fs-5 mb-1">@(_outcome.Passed ? "Aprobado" : "No aprobado")</p>
                <p class="text-muted">@_outcome.CandidateAlias · @_outcome.ObtainedPoints / @_outcome.TotalPoints pts</p>
                <p class="text-muted small">La corrección está guardada y el candidato ya tiene su resultado.</p>
                <a href="/evaluacion" class="btn btn-primary">Volver a la cola</a>
            </div>
        </div>
    }
    else if (_conflict is not null)
    {
        <div class="alert alert-warning d-flex justify-content-between align-items-center">
            <div>
                <i class="bi bi-exclamation-triangle me-2"></i>
                <strong>@_conflict</strong>
            </div>
            <a href="/evaluacion" class="btn btn-warning btn-sm">Volver a la cola</a>
        </div>
    }
    else if (_detail is null)
    {
        @* 404: no existe, no es de una prueba asignada o ya no lo está. No se distingue. *@
        <div class="alert alert-warning">
            Este resultado no está en tu cola. Puede que ya no tengas asignada su prueba.
        </div>
    }
    else
    {
        <ReservationKeeper Renew="() => Api.RenewEvaluationReservationAsync(Id)" OnLost="OnReservationLost" />

        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <div class="row g-3 align-items-center">
                    <div class="col-md-3">
                        <p class="text-muted small mb-1">Candidato</p>
                        <p class="fw-semibold mb-0">@_detail.CandidateAlias</p>
                    </div>
                    <div class="col-md-3">
                        <p class="text-muted small mb-1">Prueba</p>
                        <p class="fw-semibold mb-0">@_detail.ExamTitle</p>
                    </div>
                    <div class="col-md-2">
                        <p class="text-muted small mb-1">Enviada</p>
                        <p class="fw-semibold mb-0">@_detail.CompletedOn.ToString("dd/MM/yyyy")</p>
                    </div>
                    <div class="col-md-2">
                        <p class="text-muted small mb-1">Tipo test</p>
                        <p class="fw-semibold mb-0">@_detail.AutoScoredPoints pts</p>
                    </div>
                    <div class="col-md-2">
                        <p class="text-muted small mb-1">Total de la prueba</p>
                        <p class="fw-semibold mb-0">@_detail.TotalPoints pts</p>
                    </div>
                </div>
            </div>
        </div>

        <IntegrityPanel Report="_integrity" />

        <ReviewForm Answers="_detail.Answers"
                    AutoScoredPoints="_detail.AutoScoredPoints"
                    TotalPoints="_detail.TotalPoints"
                    Integrity="_integrity"
                    Saving="_saving"
                    Error="_error"
                    OnSubmit="SubmitAsync"
                    OnCancel="CancelAsync" />
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private bool _loading = true, _saving;
    private string? _error, _conflict;
    private EvaluatorReviewDetailDto? _detail;
    private IntegrityReportDto? _integrity;
    private EvaluatorReviewOutcomeDto? _outcome;

    protected override async Task OnInitializedAsync()
    {
        await Auth.InitializeAsync();
        if (!Auth.IsEvaluador)
        {
            Nav.NavigateTo(Auth.Home);
            return;
        }

        // Primero el detalle: abrirlo toma la reserva. Las señales solo si hay acceso.
        var (detail, status, error) = await Api.GetEvaluationDetailAsync(Id);
        if (status == 409) _conflict = error ?? "Este resultado no está disponible para corregir.";
        else if (detail is not null)
        {
            _detail = detail;
            _integrity = await Api.GetEvaluationIntegrityAsync(Id);
        }
        _loading = false;
    }

    private void OnReservationLost()
        => _conflict = "La reserva de este resultado se perdió: otra persona lo está corrigiendo.";

    private async Task CancelAsync()
    {
        await Api.ReleaseEvaluationReservationAsync(Id);
        Nav.NavigateTo("/evaluacion");
    }

    private async Task SubmitAsync(SubmitReviewDto payload)
    {
        _saving = true;
        _error = null;

        var (result, status, error) = await Api.SubmitEvaluationAsync(Id, payload);
        _saving = false;

        switch (status)
        {
            case 200: _outcome = result; break;
            case 404: _detail = null; break;
            case 409: _conflict = error ?? "Este resultado ya no está disponible para corregir."; break;
            default: _error = error ?? "No se pudo guardar la corrección. Inténtalo de nuevo."; break;
        }
    }
}
