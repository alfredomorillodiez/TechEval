@page "/"
@page "/login"
@using TechEval.Application.DTOs
@inject ApiService Api
@inject AuthStateService Auth
@inject NavigationManager Nav

<PageTitle>Iniciar sesión — TechEval</PageTitle>

<div class="d-flex justify-content-center align-items-center vh-100 bg-light">
    <div class="card border-0 shadow-lg p-4" style="max-width:420px;width:100%;">
        <div class="text-center mb-4">
            <div class="bg-primary bg-opacity-10 rounded-3 d-inline-flex p-3 mb-3">
                <i class="bi bi-shield-check text-primary" style="font-size:2rem;"></i>
            </div>
            <h1 class="h4 mb-0">TechEval Platform</h1>
            <p class="text-muted small">Panel de administración</p>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="alert alert-danger py-2">@_error</div>
        }

        <div class="mb-3">
            <label class="form-label">Email</label>
            <input type="email" class="form-control" @bind="_email"
                   placeholder="admin@techeval.com"
                   @onkeydown="OnKeyDown" />
        </div>
        <div class="mb-4">
            <label class="form-label">Contraseña</label>
            <input type="password" class="form-control" @bind="_password"
                   @onkeydown="OnKeyDown" />
        </div>

        <button class="btn btn-primary btn-lg w-100" @onclick="LoginAsync" disabled="@_loading">
            @if (_loading) { <span class="spinner-border spinner-border-sm me-2"></span> }
            Iniciar sesión
        </button>
    </div>
</div>

@code {
    private string _email = string.Empty, _password = string.Empty, _error = string.Empty;
    private bool _loading;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await Auth.InitializeAsync();
            if (Auth.IsAuthenticated) Nav.NavigateTo("/admin");
        }
    }

    private async Task LoginAsync()
    {
        _error = string.Empty;
        if (string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password))
        { _error = "Email y contraseña son obligatorios."; return; }

        _loading = true;
        var result = await Api.LoginAsync(new LoginDto(_email, _password));
        _loading = false;

        if (result is null) { _error = "Credenciales incorrectas."; return; }

        await Auth.LoginAsync(result.Token, result.Name);
        Nav.NavigateTo("/admin");
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoginAsync();
    }
}
