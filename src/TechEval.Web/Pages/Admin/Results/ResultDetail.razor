@page "/admin/results/{Id:int}"
@using TechEval.Application.DTOs
@inject ApiService Api
@inject NavigationManager Nav
@inject AuthStateService Auth

<PageTitle>Detalle de resultado — TechEval</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex align-items-center gap-3 mb-4">
        <a href="/admin/results" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h1 class="h3 mb-0 flex-grow-1">Detalle del resultado</h1>
    </div>

    @if (_loading)
    {
        <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
    }
    else if (_result is null)
    {
        <div class="alert alert-warning">No se encontró el resultado.</div>
    }
    else
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body">
                <div class="row g-3 align-items-center">
                    <div class="col-md-4">
                        <p class="text-muted small mb-1">Candidato</p>
                        <p class="fw-semibold mb-0">@_result.CandidateName</p>
                        <p class="text-muted small mb-0">@_result.CandidateEmail</p>
                    </div>
                    <div class="col-md-3">
                        <p class="text-muted small mb-1">Examen</p>
                        <p class="fw-semibold mb-0">@_result.ExamTitle</p>
                    </div>
                    <div class="col-md-2">
                        <p class="text-muted small mb-1">Puntuación</p>
                        <p class="fw-semibold mb-0">@_result.ObtainedPoints / @_result.TotalPoints pts</p>
                        <div class="progress mt-1" style="height:5px;">
                            <div class="progress-bar @(_result.Passed ? "bg-success" : "bg-danger")"
                                 style="width:@_result.ScorePercentage%"></div>
                        </div>
                        <p class="small mt-1 mb-0">@_result.ScorePercentage%</p>
                    </div>
                    <div class="col-md-2 text-center">
                        <span class="badge @(_result.Passed ? "bg-success" : "bg-danger") fs-6 px-3 py-2">
                            @(_result.Passed ? "Aprobado" : "Reprobado")
                        </span>
                    </div>
                    <div class="col-md-1 text-end">
                        <p class="text-muted small mb-1">Fecha</p>
                        <p class="small mb-0">@_result.CompletedAt.ToLocalTime().ToString("dd/MM/yyyy")</p>
                        <p class="small mb-0">@_result.CompletedAt.ToLocalTime().ToString("HH:mm")</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 pt-3">
                <h5 class="mb-0">Respuestas <span class="badge bg-secondary ms-1">@_result.Answers.Count</span></h5>
            </div>
            <div class="card-body p-0">
                @foreach (var (answer, index) in _result.Answers.Select((a, i) => (a, i + 1)))
                {
                    <div class="border-bottom p-4 @(answer.IsCorrect == true ? "bg-success bg-opacity-10" : answer.IsCorrect == false ? "bg-danger bg-opacity-10" : "")">
                        <div class="d-flex gap-3 align-items-start">
                            <span class="badge bg-secondary rounded-pill px-2 py-1 mt-1" style="min-width:2rem;text-align:center;">@index</span>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <p class="fw-semibold mb-0 flex-grow-1 me-3">@answer.QuestionText</p>
                                    <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                        <span class="badge bg-primary">@answer.Points pt@(answer.Points != 1 ? "s" : "")</span>
                                        @if (answer.IsCorrect.HasValue)
                                        {
                                            <span class="badge @(answer.IsCorrect.Value ? "bg-success" : "bg-danger")">
                                                <i class="bi @(answer.IsCorrect.Value ? "bi-check-lg" : "bi-x-lg") me-1"></i>
                                                @(answer.IsCorrect.Value ? "Correcta" : "Incorrecta")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Revisión manual</span>
                                        }
                                    </div>
                                </div>

                                <div class="row g-2 mt-1">
                                    <div class="col-md-6">
                                        <p class="text-muted small mb-1">Respuesta del candidato</p>
                                        <div class="px-3 py-2 rounded border @(answer.IsCorrect == true ? "border-success bg-white" : answer.IsCorrect == false ? "border-danger bg-white" : "bg-light")">
                                            @if (!string.IsNullOrEmpty(answer.SelectedAnswerText))
                                            {
                                                <span>@answer.SelectedAnswerText</span>
                                            }
                                            else if (!string.IsNullOrEmpty(answer.OpenAnswer))
                                            {
                                                <span class="fst-italic">@answer.OpenAnswer</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted fst-italic">Sin respuesta</span>
                                            }
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrEmpty(answer.CorrectAnswerText))
                                    {
                                        <div class="col-md-6">
                                            <p class="text-muted small mb-1">Respuesta correcta</p>
                                            <div class="px-3 py-2 rounded border border-success bg-success bg-opacity-10">
                                                <i class="bi bi-check-circle-fill text-success me-1"></i>
                                                @answer.CorrectAnswerText
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private ExamResultDto? _result;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        await Auth.InitializeAsync();
        if (!Auth.IsAuthenticated) { Nav.NavigateTo("/login"); return; }
        _result = await Api.GetResultDetailAsync(Id);
        _loading = false;
    }
}
