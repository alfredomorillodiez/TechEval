FROM mcr.microsoft.com/dotnet/sdk:9.0 AS build
WORKDIR /src

COPY src/TechEval.Domain/TechEval.Domain.csproj src/TechEval.Domain/
COPY src/TechEval.Application/TechEval.Application.csproj src/TechEval.Application/
COPY src/TechEval.Infrastructure/TechEval.Infrastructure.csproj src/TechEval.Infrastructure/
COPY src/TechEval.API/TechEval.API.csproj src/TechEval.API/

RUN dotnet restore src/TechEval.API/TechEval.API.csproj

COPY src/ src/

RUN dotnet publish src/TechEval.API/TechEval.API.csproj -c Release -o /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:9.0 AS runtime
WORKDIR /app
EXPOSE 8080

COPY --from=build /app/publish .

ENTRYPOINT ["dotnet", "TechEval.API.dll"]
