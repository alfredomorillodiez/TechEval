@page "/admin/questions"
@implements IDisposable
@using TechEval.Application
@using TechEval.Application.DTOs
@using TechEval.Domain.Enums
@inject ApiService Api
@inject NavigationManager Nav
@inject AuthStateService Auth
@inject ListState Lists

<PageTitle>Preguntas — TechEval</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Banco de preguntas</h1>
        <div class="d-flex gap-2">
            <a href="/admin/questions/new" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i> Nueva pregunta
            </a>
        </div>
    </div>

    <!-- Filtros -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <select class="form-select" value="@(_categoryId?.ToString() ?? "")" @onchange="OnCategoryChange">
                        <option value="">Todas las categorías</option>
                        @foreach (var c in _categories)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <select class="form-select" value="@(_difficulty is { } d ? ((int)d).ToString() : "")" @onchange="OnDifficultyChange">
                        <option value="">Todos los niveles</option>
                        <option value="1">Básico</option>
                        <option value="2">Intermedio</option>
                        <option value="3">Avanzado</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <select class="form-select" value="@(_type is { } t ? ((int)t).ToString() : "")" @onchange="OnTypeChange">
                        <option value="">Todos los tipos</option>
                        <option value="1">Test (4 opciones)</option>
                        <option value="2">Respuesta abierta</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    @if (_categoriesFailed)
    {
        <LoadError What="las categorías del filtro" OnRetry="LoadCategoriesAsync" />
    }
    @if (!string.IsNullOrEmpty(_deleteError))
    {
        <div class="alert alert-danger alert-dismissible mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@_deleteError
            <button type="button" class="btn-close" aria-label="Cerrar" @onclick="() => _deleteError = string.Empty"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-warning d-flex align-items-center gap-2 mb-4">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@_error</span>
            <button class="btn btn-sm btn-outline-warning ms-auto" @onclick="LoadQuestionsAsync">
                <i class="bi bi-arrow-clockwise me-1"></i>Reintentar
            </button>
        </div>
    }

    @if (_loading)
    {
        <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <SortHeader Key="text" State="_sort" OnSort="SortBy">Pregunta</SortHeader>
                                <SortHeader Key="category" State="_sort" OnSort="SortBy">Categoría</SortHeader>
                                <SortHeader Key="difficulty" State="_sort" OnSort="SortBy">Nivel</SortHeader>
                                <SortHeader Key="type" State="_sort" OnSort="SortBy">Tipo</SortHeader>
                                <SortHeader Key="points" State="_sort" OnSort="SortBy">Puntos</SortHeader>
                                <SortHeader Key="status" State="_sort" OnSort="SortBy">Estado</SortHeader>
                                <th>Acciones</th>
                            </tr>
                            <tr>
                                <th>
                                    <input class="form-control form-control-sm" placeholder="Buscar..." value="@_textFilter"
                                           @oninput="e => _textFilter = e.Value?.ToString() ?? string.Empty" />
                                </th>
                                <th>
                                    <select class="form-select form-select-sm" value="@_catFilter"
                                            @onchange="e => _catFilter = e.Value?.ToString() ?? string.Empty">
                                        <option value="">Todas</option>
                                        @foreach (var c in _categories)
                                        {
                                            <option value="@c.Name">@c.Name</option>
                                        }
                                    </select>
                                </th>
                                <th>
                                    <select class="form-select form-select-sm" value="@_diffFilter"
                                            @onchange="e => _diffFilter = e.Value?.ToString() ?? string.Empty">
                                        <option value="">Todos</option>
                                        <option value="Basic">Básico</option>
                                        <option value="Intermediate">Intermedio</option>
                                        <option value="Advanced">Avanzado</option>
                                    </select>
                                </th>
                                <th>
                                    <select class="form-select form-select-sm" value="@_typeFilter"
                                            @onchange="e => _typeFilter = e.Value?.ToString() ?? string.Empty">
                                        <option value="">Todos</option>
                                        <option value="MultipleChoice">Test</option>
                                        <option value="OpenEnded">Abierta</option>
                                    </select>
                                </th>
                                <th></th>
                                <th>
                                    <select class="form-select form-select-sm" value="@_activeFilter"
                                            @onchange="e => _activeFilter = e.Value?.ToString() ?? string.Empty">
                                        <option value="">Todos</option>
                                        <option value="true">Activa</option>
                                        <option value="false">Inactiva</option>
                                    </select>
                                </th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var q in DisplayedQuestions)
                            {
                                <tr>
                                    <td style="max-width:350px;">
                                        <span class="text-truncate d-block" title="@q.Text">@q.Text</span>
                                    </td>
                                    <td><span class="badge bg-secondary">@q.CategoryName</span></td>
                                    <td>
                                        <span class="badge @DifficultyClass(q.Difficulty)">
                                            @DifficultyLabel(q.Difficulty)
                                        </span>
                                    </td>
                                    <td>@(q.Type == QuestionType.MultipleChoice ? "Test" : "Abierta")</td>
                                    <td><strong>@q.Points</strong></td>
                                    <td>
                                        <span class="badge @(q.IsActive ? "bg-success" : "bg-secondary")">
                                            @(q.IsActive ? "Activa" : "Inactiva")
                                        </span>
                                    </td>
                                    <td>
                                        <a href="/admin/questions/@q.Id" class="btn btn-sm btn-outline-primary me-1">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button class="btn btn-sm btn-outline-danger"
                                                @onclick="() => DeleteAsync(q.Id)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (!DisplayedQuestions.Any())
                {
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-inbox fs-1"></i>
                        <p class="mt-2">No hay preguntas que coincidan con los filtros.</p>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private List<QuestionSummaryDto> _questions = new();
    private List<CategoryDto> _categories = new();
    private bool _loading = true, _categoriesFailed;
    private string _error = string.Empty;
    private string _deleteError = string.Empty;
    private int? _categoryId;
    private DifficultyLevel? _difficulty;
    private QuestionType? _type;

    private string _textFilter = string.Empty;
    private string _catFilter = string.Empty;
    private string _diffFilter = string.Empty;
    private string _typeFilter = string.Empty;
    private string _activeFilter = string.Empty;

    private IEnumerable<QuestionSummaryDto> DisplayedQuestions => ListSort.Apply(_questions
        .Where(q => string.IsNullOrEmpty(_textFilter) ||
                    q.Text.Contains(_textFilter, StringComparison.OrdinalIgnoreCase))
        .Where(q => string.IsNullOrEmpty(_catFilter) ||
                    q.CategoryName == _catFilter)
        .Where(q => string.IsNullOrEmpty(_diffFilter) ||
                    q.Difficulty.ToString() == _diffFilter)
        .Where(q => string.IsNullOrEmpty(_typeFilter) ||
                    q.Type.ToString() == _typeFilter)
        .Where(q => string.IsNullOrEmpty(_activeFilter) ||
                    q.IsActive.ToString().ToLower() == _activeFilter),
        _sort, Columns);

    // Búsqueda, filtros y orden se conservan al abrir una pregunta y volver. El de servidor
    // (categoría, nivel, tipo) se restaura antes de la primera carga, para que salga en ella.
    private const string StateKey = "questions";
    private readonly SortState _sort = new();

    private sealed record Saved(
        string Text, string Cat, string Diff, string Type, string Active,
        int? CategoryId, DifficultyLevel? Difficulty, QuestionType? QType, SortState Sort);

    private static readonly IReadOnlyDictionary<string, Func<QuestionSummaryDto, object?>> Columns =
        new Dictionary<string, Func<QuestionSummaryDto, object?>>
        {
            ["text"] = q => q.Text,
            ["category"] = q => q.CategoryName,
            ["difficulty"] = q => (int)q.Difficulty,
            ["type"] = q => (int)q.Type,
            ["points"] = q => q.Points,
            ["status"] = q => q.IsActive
        };

    private void SortBy(string key) => _sort.Toggle(key);

    public void Dispose() => Lists.Set(StateKey, new Saved(
        _textFilter, _catFilter, _diffFilter, _typeFilter, _activeFilter,
        _categoryId, _difficulty, _type, _sort.Clone()));

    protected override async Task OnInitializedAsync()
    {
        await Auth.InitializeAsync();
        if (!Auth.IsAdmin) { Nav.NavigateTo(Auth.Home); return; }

        if (Lists.Get<Saved>(StateKey) is { } saved)
        {
            _textFilter = saved.Text; _catFilter = saved.Cat; _diffFilter = saved.Diff;
            _typeFilter = saved.Type; _activeFilter = saved.Active;
            _categoryId = saved.CategoryId; _difficulty = saved.Difficulty; _type = saved.QType;
            _sort.Key = saved.Sort.Key; _sort.Descending = saved.Sort.Descending;
        }

        await LoadCategoriesAsync();
        await LoadQuestionsAsync();
    }

    private async Task LoadCategoriesAsync()
    {
        var categories = await Api.GetCategoriesAsync(includeInactive: true);
        _categoriesFailed = categories is null;
        if (categories is not null) _categories = categories;
    }

    private async Task LoadQuestionsAsync()
    {
        _loading = true;
        _error = string.Empty;
        var result = await Api.GetQuestionsAsync(_categoryId, _difficulty, _type);
        if (result is null)
            _error = "No se pudo conectar con la API. Verifica que la API esté activa y que tu sesión sea válida.";
        else
            _questions = result;
        _loading = false;
    }

    private async Task OnCategoryChange(ChangeEventArgs e)
    {
        _categoryId = string.IsNullOrEmpty(e.Value?.ToString()) ? null : int.Parse(e.Value.ToString()!);
        await LoadQuestionsAsync();
    }

    private async Task OnDifficultyChange(ChangeEventArgs e)
    {
        _difficulty = string.IsNullOrEmpty(e.Value?.ToString()) ? null :
            (DifficultyLevel)int.Parse(e.Value.ToString()!);
        await LoadQuestionsAsync();
    }

    private async Task OnTypeChange(ChangeEventArgs e)
    {
        _type = string.IsNullOrEmpty(e.Value?.ToString()) ? null :
            (QuestionType)int.Parse(e.Value.ToString()!);
        await LoadQuestionsAsync();
    }

    private async Task DeleteAsync(int id)
    {
        _deleteError = string.Empty;
        if (await Api.DeleteQuestionAsync(id))
            _questions.RemoveAll(q => q.Id == id);
        else
            _deleteError = "No se pudo dar de baja la pregunta. Comprueba la conexión e inténtalo de nuevo.";
    }

    private static string DifficultyClass(DifficultyLevel d) => d switch
    {
        DifficultyLevel.Basic => "bg-success",
        DifficultyLevel.Intermediate => "bg-warning text-dark",
        DifficultyLevel.Advanced => "bg-danger",
        _ => "bg-secondary"
    };

    private static string DifficultyLabel(DifficultyLevel d) => d switch
    {
        DifficultyLevel.Basic => "Básico",
        DifficultyLevel.Intermediate => "Intermedio",
        DifficultyLevel.Advanced => "Avanzado",
        _ => d.ToString()
    };
}
