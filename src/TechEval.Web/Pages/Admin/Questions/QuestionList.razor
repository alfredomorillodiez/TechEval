@page "/admin/questions"
@implements IDisposable
@using TechEval.Application
@using TechEval.Application.DTOs
@using TechEval.Domain.Common
@using TechEval.Domain.Enums
@inject ApiService Api
@inject NavigationManager Nav
@inject AuthStateService Auth
@inject ListState Lists

<PageTitle>Preguntas — TechEval</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Banco de preguntas</h1>
        <div class="d-flex gap-2">
            <a href="/admin/questions/new" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i> Nueva pregunta
            </a>
        </div>
    </div>

    <!-- Filtros -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <select class="form-select" aria-label="Categoría" value="@(_categoryId?.ToString() ?? "")" @onchange="OnCategoryChange">
                        <option value="">Todas las categorías</option>
                        @foreach (var c in _categories)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <select class="form-select" aria-label="Nivel" value="@(_difficulty is { } d ? ((int)d).ToString() : "")" @onchange="OnDifficultyChange">
                        <option value="">Todos los niveles</option>
                        <option value="1">Básico</option>
                        <option value="2">Intermedio</option>
                        <option value="3">Avanzado</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <select class="form-select" aria-label="Tipo" value="@(_type is { } t ? ((int)t).ToString() : "")" @onchange="OnTypeChange">
                        <option value="">Todos los tipos</option>
                        <option value="1">Test (4 opciones)</option>
                        <option value="2">Respuesta abierta</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    @if (_categoriesFailed)
    {
        <LoadError What="las categorías del filtro" OnRetry="LoadCategoriesAsync" />
    }
    @if (!string.IsNullOrEmpty(_deleteError))
    {
        <div class="alert alert-danger alert-dismissible mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@_deleteError
            <button type="button" class="btn-close" aria-label="Cerrar" @onclick="() => _deleteError = string.Empty"></button>
        </div>
    }
    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="alert alert-warning d-flex align-items-center gap-2 mb-4">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@_error</span>
            <button class="btn btn-sm btn-outline-warning ms-auto" @onclick="LoadQuestionsAsync">
                <i class="bi bi-arrow-clockwise me-1"></i>Reintentar
            </button>
        </div>
    }

    @if (_firstLoad)
    {
        <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
    }
    else
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0 @(_busy ? "opacity-50" : "")" aria-busy="@(_busy ? "true" : "false")">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <SortHeader Key="text" State="_sort" OnSort="SortBy">Pregunta</SortHeader>
                                <SortHeader Key="category" State="_sort" OnSort="SortBy">Categoría</SortHeader>
                                <SortHeader Key="difficulty" State="_sort" OnSort="SortBy">Nivel</SortHeader>
                                <SortHeader Key="type" State="_sort" OnSort="SortBy">Tipo</SortHeader>
                                <SortHeader Key="points" State="_sort" OnSort="SortBy">Puntos</SortHeader>
                                <SortHeader Key="status" State="_sort" OnSort="SortBy">Estado</SortHeader>
                                <th>Acciones</th>
                            </tr>
                            <tr>
                                <th>
                                    <input class="form-control form-control-sm" placeholder="Buscar..." aria-label="Buscar en el enunciado"
                                           value="@_textFilter" @oninput="OnSearchInput" />
                                </th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th></th>
                                <th>
                                    <select class="form-select form-select-sm" aria-label="Estado" value="@_activeFilter"
                                            @onchange="OnActiveChange">
                                        <option value="true">Activas</option>
                                        <option value="false">Inactivas</option>
                                        <option value="">Todas</option>
                                    </select>
                                </th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var q in _questions)
                            {
                                <tr>
                                    <td style="max-width:350px;">
                                        <span class="text-truncate d-block" title="@q.Text">@q.Text</span>
                                    </td>
                                    <td><span class="badge bg-secondary">@q.CategoryName</span></td>
                                    <td>
                                        <span class="badge @DifficultyClass(q.Difficulty)">
                                            @DifficultyLabel(q.Difficulty)
                                        </span>
                                    </td>
                                    <td>@(q.Type == QuestionType.MultipleChoice ? "Test" : "Abierta")</td>
                                    <td><strong>@q.Points</strong></td>
                                    <td>
                                        <span class="badge @(q.IsActive ? "bg-success" : "bg-secondary")">
                                            @(q.IsActive ? "Activa" : "Inactiva")
                                        </span>
                                    </td>
                                    <td>
                                        <a href="/admin/questions/@q.Id" class="btn btn-sm btn-outline-primary me-1">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button class="btn btn-sm btn-outline-danger"
                                                @onclick="() => DeleteAsync(q.Id)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (!_questions.Any())
                {
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-inbox fs-1"></i>
                        <p class="mt-2">No hay preguntas que coincidan con los filtros.</p>
                    </div>
                }
            </div>
        </div>

        <Pager State="_page" Noun="preguntas" OnPage="GoToPageAsync" OnPageSize="SetPageSizeAsync" />
    }
</div>

@code {
    private List<QuestionSummaryDto> _questions = new();
    private List<CategoryDto> _categories = new();
    private bool _firstLoad = true, _busy, _categoriesFailed;
    private string _error = string.Empty;
    private string _deleteError = string.Empty;
    private int? _categoryId;
    private DifficultyLevel? _difficulty;
    private QuestionType? _type;

    private string _textFilter = string.Empty;

    // «Activas» por defecto: es lo que el administrador veía antes. La lista no devolvía las inactivas,
    // y por eso el filtro «Estado» que ya existía nunca podía mostrarlas.
    private string _activeFilter = "true";

    // Búsqueda, filtros, orden y página se conservan al abrir una pregunta y volver.
    private const string StateKey = "questions";
    private readonly SortState _sort = new();
    private readonly PageState _page = new();
    private readonly ListLoader _loader = new();

    private sealed record Saved(
        string Text, string Active, int? CategoryId, DifficultyLevel? Difficulty, QuestionType? QType,
        SortState Sort, int Page, int PageSize);

    public void Dispose()
    {
        Lists.Set(StateKey, new Saved(
            _textFilter, _activeFilter, _categoryId, _difficulty, _type,
            _sort.Clone(), _page.Page, _page.PageSize));
        _loader.Dispose();
    }

    protected override async Task OnInitializedAsync()
    {
        await Auth.InitializeAsync();
        if (!Auth.IsAdmin) { Nav.NavigateTo(Auth.Home); return; }

        if (Lists.Get<Saved>(StateKey) is { } saved)
        {
            _textFilter = saved.Text; _activeFilter = saved.Active;
            _categoryId = saved.CategoryId; _difficulty = saved.Difficulty; _type = saved.QType;
            _sort.Key = saved.Sort.Key; _sort.Descending = saved.Sort.Descending;
            _page.Page = saved.Page; _page.PageSize = saved.PageSize;
        }

        await LoadCategoriesAsync();
        await LoadQuestionsAsync();
        _firstLoad = false;
    }

    private async Task LoadCategoriesAsync()
    {
        var categories = await Api.GetCategoriesAsync(includeInactive: true);
        _categoriesFailed = categories is null;
        if (categories is not null) _categories = categories;
    }

    private async Task LoadQuestionsAsync()
    {
        _busy = true;
        _error = string.Empty;
        bool? active = bool.TryParse(_activeFilter, out var a) ? a : null;
        var filter = new QuestionFilter(_categoryId, _difficulty, _type, active);

        // Si la página guardada ya no existe, o se vació al dar de baja la última fila, se pide la última.
        for (var attempt = 0; attempt < 2; attempt++)
        {
            var again = false;
            var query = _page.ToQuery(_textFilter, _sort);
            var applied = await _loader.LoadAsync(() => Api.GetQuestionsPageAsync(query, filter), r =>
            {
                if (r is null)
                {
                    _error = "No se pudo conectar con la API. Verifica que la API esté activa y que tu sesión sea válida.";
                    return;
                }

                var beyond = _page.IsBeyondEnd(r);
                _page.Apply(r);
                if (beyond) { _page.GoToLast(); again = true; return; }
                _questions = r.Items.ToList();
            });

            if (!applied) return;
            if (!again) break;
        }

        _busy = false;
        StateHasChanged();
    }

    // Buscar, filtrar u ordenar vuelve a la primera página.
    private async Task Refilter()
    {
        _page.Reset();
        await LoadQuestionsAsync();
    }

    private async Task OnCategoryChange(ChangeEventArgs e)
    {
        _categoryId = string.IsNullOrEmpty(e.Value?.ToString()) ? null : int.Parse(e.Value.ToString()!);
        await Refilter();
    }

    private async Task OnDifficultyChange(ChangeEventArgs e)
    {
        _difficulty = string.IsNullOrEmpty(e.Value?.ToString()) ? null :
            (DifficultyLevel)int.Parse(e.Value.ToString()!);
        await Refilter();
    }

    private async Task OnTypeChange(ChangeEventArgs e)
    {
        _type = string.IsNullOrEmpty(e.Value?.ToString()) ? null :
            (QuestionType)int.Parse(e.Value.ToString()!);
        await Refilter();
    }

    private async Task OnActiveChange(ChangeEventArgs e)
    {
        _activeFilter = e.Value?.ToString() ?? string.Empty;
        await Refilter();
    }

    private Task OnSearchInput(ChangeEventArgs e)
    {
        _textFilter = e.Value?.ToString() ?? string.Empty;
        _page.Reset();
        _ = _loader.DebounceAsync(LoadQuestionsAsync);
        return Task.CompletedTask;
    }

    private async Task SortBy(string key)
    {
        _sort.Toggle(key);
        await Refilter();
    }

    private async Task GoToPageAsync(int page)
    {
        _page.Page = page;
        await LoadQuestionsAsync();
    }

    private async Task SetPageSizeAsync(int size)
    {
        _page.SetPageSize(size);
        await LoadQuestionsAsync();
    }

    private async Task DeleteAsync(int id)
    {
        _deleteError = string.Empty;
        // Dar de baja la desactiva. Se recarga la página en vez de quitar la fila: con el filtro en
        // «Activas» la fila sale, y si era la última de la página hay que volver a la anterior.
        if (await Api.DeleteQuestionAsync(id))
            await LoadQuestionsAsync();
        else
            _deleteError = "No se pudo dar de baja la pregunta. Comprueba la conexión e inténtalo de nuevo.";
    }

    private static string DifficultyClass(DifficultyLevel d) => d switch
    {
        DifficultyLevel.Basic => "bg-success",
        DifficultyLevel.Intermediate => "bg-warning text-dark",
        DifficultyLevel.Advanced => "bg-danger",
        _ => "bg-secondary"
    };

    private static string DifficultyLabel(DifficultyLevel d) => d switch
    {
        DifficultyLevel.Basic => "Básico",
        DifficultyLevel.Intermediate => "Intermedio",
        DifficultyLevel.Advanced => "Avanzado",
        _ => d.ToString()
    };
}
