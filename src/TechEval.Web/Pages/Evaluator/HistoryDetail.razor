@page "/evaluacion/historial/{Id:int}"
@using TechEval.Application.DTOs
@inject ApiService Api
@inject NavigationManager Nav
@inject AuthStateService Auth

<PageTitle>Corrección — TechEval</PageTitle>

@* Solo lectura: lo que el evaluador puntuó y comentó. No hay forma de cambiarlo desde aquí. *@
<div class="container-lg py-4">
    <div class="d-flex align-items-center gap-3 mb-4">
        <a href="/evaluacion/historial" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h1 class="h3 mb-0 flex-grow-1">@(_detail?.CandidateAlias ?? "Corrección")</h1>
    </div>

    @if (_loading)
    {
        <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
    }
    else if (_detail is null)
    {
        <div class="alert alert-warning">No se encontró esta corrección entre las tuyas.</div>
    }
    else
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body d-flex flex-wrap gap-4">
                <div><p class="text-muted small mb-1">Prueba</p><p class="fw-semibold mb-0">@_detail.ExamTitle</p></div>
                <div><p class="text-muted small mb-1">Corregida</p><p class="fw-semibold mb-0">@_detail.ReviewedOn.ToString("dd/MM/yyyy")</p></div>
                <div><p class="text-muted small mb-1">Puntos</p><p class="fw-semibold mb-0">@_detail.ObtainedPoints / @_detail.TotalPoints</p></div>
                <div>
                    <p class="text-muted small mb-1">Resultado</p>
                    <span class="badge @(_detail.Passed ? "bg-success" : "bg-danger")">
                        @_detail.ScorePercentage% · @(_detail.Passed ? "Aprobado" : "No aprobado")
                    </span>
                </div>
            </div>
        </div>

        @foreach (var (a, i) in _detail.Answers.Select((a, i) => (a, i + 1)))
        {
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body">
                    <div class="d-flex gap-3">
                        <span class="badge bg-secondary rounded-pill px-2 py-1 mt-1" style="min-width:2rem;text-align:center;">@i</span>
                        <div class="flex-grow-1">
                            <p class="fw-semibold mb-2">@a.QuestionText</p>
                            <div class="px-3 py-2 rounded border bg-light mb-2" style="white-space:pre-wrap;">
                                @if (string.IsNullOrWhiteSpace(a.OpenAnswer)) { <span class="text-muted fst-italic">Sin respuesta</span> }
                                else { @a.OpenAnswer }
                            </div>
                            <p class="mb-0">
                                <strong>@(a.AwardedPoints ?? 0) / @a.MaxPoints pts</strong>
                                @if (!string.IsNullOrWhiteSpace(a.ReviewerComment))
                                {
                                    <span class="text-muted"> · @a.ReviewerComment</span>
                                }
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter] public int Id { get; set; }

    private bool _loading = true;
    private EvaluatorHistoryDetailDto? _detail;

    protected override async Task OnInitializedAsync()
    {
        await Auth.InitializeAsync();
        if (!Auth.IsEvaluador) { Nav.NavigateTo(Auth.Home); return; }

        _detail = await Api.GetEvaluationHistoryDetailAsync(Id);
        _loading = false;
    }
}
