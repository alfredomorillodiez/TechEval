@page "/admin/pruebas/generate"
@using TechEval.Application.DTOs
@using TechEval.Domain.Enums
@using TechEval.Application.Services
@inject ApiService Api
@inject NavigationManager Nav
@inject AuthStateService Auth

<PageTitle>Generar prueba — TechEval</PageTitle>

<div class="container py-4" style="max-width: 700px;">
    <div class="d-flex align-items-center mb-4 gap-3">
        <a href="/admin/pruebas" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h1 class="h3 mb-0">Generar prueba automática</h1>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="alert alert-danger">@_error</div>
            }

            <div class="mb-3">
                <label class="form-label fw-semibold">Título de la prueba *</label>
                <input class="form-control" @bind="_title" placeholder="Ej: Evaluación técnica SQL — Junio 2024" />
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Descripción</label>
                <textarea class="form-control" rows="2" @bind="_description"></textarea>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Número de preguntas *</label>
                    <input type="number" class="form-control" @bind="_questionCount" @bind:event="oninput" min="1" max="50" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Tiempo límite (min) *</label>
                    <input type="number" class="form-control" @bind="_timeLimitMinutes" min="10" max="240" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">% mínimo para aprobar</label>
                    <input type="number" class="form-control" @bind="_passingScore" min="50" max="100" />
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-8">
                    <label class="form-label fw-semibold">
                        Categorías
                        @if (_selectedCategoryIds.Count > 0)
                        {
                            <span class="badge bg-primary ms-2">@_selectedCategoryIds.Count seleccionada@(_selectedCategoryIds.Count != 1 ? "s" : "")</span>
                        }
                        else
                        {
                            <span class="text-muted fw-normal small ms-1">(todas)</span>
                        }
                    </label>
                    <div class="border rounded p-3" style="max-height:180px;overflow-y:auto;background:#fafafa;">
                        @foreach (var c in _categories)
                        {
                            var catId = c.Id;
                            var isChecked = _selectedCategoryIds.Contains(catId);
                            <div class="form-check mb-1">
                                <input class="form-check-input" type="checkbox"
                                       id="cat_@c.Id"
                                       checked="@isChecked"
                                       @onchange="() => ToggleCategory(catId)" />
                                <label class="form-check-label" for="cat_@c.Id">@c.Name</label>
                            </div>
                        }
                    </div>
                    @if (_selectedCategoryIds.Count > 0)
                    {
                        <button class="btn btn-link btn-sm p-0 mt-1 text-muted"
                                @onclick="ClearCategoriesAsync">
                            Limpiar selección
                        </button>
                    }
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Dificultad (opcional)</label>
                    <select class="form-select" @bind="_mode">
                        <option value="">Todos los niveles</option>
                        <option value="@DifficultyLevel.Basic">Básico</option>
                        <option value="@DifficultyLevel.Intermediate">Intermedio</option>
                        <option value="@DifficultyLevel.Advanced">Avanzado</option>
                        <option value="@DistributionMode">Reparto por nivel</option>
                    </select>
                </div>
            </div>

            @if (IsDistribution)
            {
                var plan = Preview;
                var suma = _percentages.Values.Sum();
                <div class="border rounded p-3 mb-4" style="background:#fafafa;">
                    <p class="fw-semibold mb-2">Reparto por nivel <span class="text-muted fw-normal small">(porcentaje de preguntas)</span></p>
                    <table class="table table-sm align-middle mb-2">
                        <thead class="small text-muted">
                            <tr><th>Nivel</th><th style="width:110px;">%</th><th>Preguntas</th><th>Disponibles</th></tr>
                        </thead>
                        <tbody>
                            @foreach (var level in DifficultyPlanner.Levels)
                            {
                                var nivel = level;
                                var falta = plan?.Shortages.FirstOrDefault(s => s.Level == nivel);
                                <tr class="@(falta is null ? "" : "table-danger")">
                                    <td>@LevelName(nivel)</td>
                                    <td>
                                        <input type="number" class="form-control form-control-sm" min="0" max="100"
                                               value="@_percentages[nivel]"
                                               @oninput="e => SetPercentage(nivel, e.Value)" />
                                    </td>
                                    <td>@(plan?.Requested[nivel].ToString() ?? "—")</td>
                                    <td>
                                        @(_available?.GetValueOrDefault(nivel).ToString() ?? "…")
                                        @if (falta is not null)
                                        {
                                            <span class="small text-danger ms-1">necesita @falta.Needed, hay @falta.Available</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    @if (suma != 100)
                    {
                        <p class="small text-danger mb-0">
                            Los porcentajes suman @suma %: @(suma < 100 ? $"falta un {100 - suma} %" : $"sobra un {suma - 100} %").
                        </p>
                    }
                    else if (plan is { CanGenerate: false })
                    {
                        <p class="small text-danger mb-0">
                            No hay preguntas suficientes en los niveles marcados con las categorías elegidas.
                            Cambia el reparto, el número de preguntas o las categorías.
                        </p>
                    }
                </div>
            }

            <div class="d-flex justify-content-end gap-2">
                <a href="/admin/pruebas" class="btn btn-outline-secondary">Cancelar</a>
                <button class="btn btn-primary" @onclick="GenerateAsync" disabled="@(_loading || !CanGenerate)">
                    @if (_loading) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    <i class="bi bi-magic me-1"></i> Generar prueba
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private const string DistributionMode = "reparto";

    private string _title = string.Empty, _description = string.Empty, _error = string.Empty;
    private int _questionCount = 10, _timeLimitMinutes = 60, _passingScore = 70;
    private HashSet<int> _selectedCategoryIds = new();
    private List<CategoryDto> _categories = new();
    private bool _loading;

    // "" = todos los niveles; un DifficultyLevel = nivel único; "reparto" = reparto por nivel.
    private string _mode = string.Empty;
    private readonly Dictionary<DifficultyLevel, int> _percentages = new()
    {
        [DifficultyLevel.Basic] = 34,
        [DifficultyLevel.Intermediate] = 33,
        [DifficultyLevel.Advanced] = 33
    };
    private Dictionary<DifficultyLevel, int>? _available;

    private bool IsDistribution => _mode == DistributionMode;
    private DifficultyLevel? SingleLevel => Enum.TryParse<DifficultyLevel>(_mode, out var l) ? l : null;

    // La misma regla que el servidor: la vista previa no puede prometer otra cosa.
    private DifficultyPlan? Preview
    {
        get
        {
            if (_available is null || _questionCount < 1 || _percentages.Values.Sum() != 100
                || _percentages.Values.Any(p => p is < 0 or > 100))
                return null;
            return DifficultyPlanner.Plan(_questionCount, _percentages, _available);
        }
    }

    private bool CanGenerate => !IsDistribution || Preview is { CanGenerate: true };

    protected override async Task OnInitializedAsync()
    {
        await Auth.InitializeAsync();
        if (!Auth.IsAdmin) { Nav.NavigateTo(Auth.Home); return; }
        _categories = await Api.GetCategoriesAsync() ?? new();
        await LoadAvailabilityAsync();
    }

    private async Task LoadAvailabilityAsync()
    {
        var counts = await Api.GetQuestionAvailabilityAsync(_selectedCategoryIds);
        _available = counts?.ToDictionary(c => c.Level, c => c.Count);
    }

    private async Task ToggleCategory(int id)
    {
        if (_selectedCategoryIds.Contains(id)) _selectedCategoryIds.Remove(id);
        else _selectedCategoryIds.Add(id);
        await LoadAvailabilityAsync();
    }

    private async Task ClearCategoriesAsync()
    {
        _selectedCategoryIds.Clear();
        await LoadAvailabilityAsync();
    }

    private void SetPercentage(DifficultyLevel level, object? value)
        => _percentages[level] = int.TryParse(value?.ToString(), out var p) ? p : 0;

    private static string LevelName(DifficultyLevel level) => level switch
    {
        DifficultyLevel.Basic => "Básico",
        DifficultyLevel.Intermediate => "Intermedio",
        _ => "Avanzado"
    };

    private async Task GenerateAsync()
    {
        _error = string.Empty;
        if (string.IsNullOrWhiteSpace(_title)) { _error = "El título es obligatorio."; return; }

        _loading = true;
        var categoryIds = _selectedCategoryIds.Count > 0 ? _selectedCategoryIds.ToList() : null;
        var (result, status, error) = await Api.GenerateExamAsync(new GenerateExamDto(
            _title, _description, _timeLimitMinutes, _passingScore,
            _questionCount, categoryIds, SingleLevel,
            IsDistribution ? new Dictionary<DifficultyLevel, int>(_percentages) : null));
        _loading = false;

        if (result is not null) { Nav.NavigateTo("/admin/pruebas"); return; }

        // Con reparto, el mensaje del servidor dice qué nivel no alcanza. Sin reparto, el de siempre.
        _error = IsDistribution && status == 400 && error is not null
            ? error
            : "No hay suficientes preguntas con los filtros seleccionados. Prueba cambiando los filtros.";

        // La disponibilidad pudo cambiar desde que se cargó.
        await LoadAvailabilityAsync();
    }
}
