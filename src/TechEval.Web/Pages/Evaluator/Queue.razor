@page "/evaluacion"
@implements IDisposable
@using TechEval.Application
@using TechEval.Application.DTOs
@inject ApiService Api
@inject NavigationManager Nav
@inject AuthStateService Auth
@inject ListState Lists

<PageTitle>Correcciones — TechEval</PageTitle>

@* A ciegas: la API no envía el nombre ni el email del candidato, y aquí no hay dónde
   mostrarlos. El candidato es su alias; la fecha va sin hora. *@
<div class="container-lg py-4">
    <div class="d-flex align-items-center gap-3 mb-4">
        <h1 class="h3 mb-0 flex-grow-1">Correcciones pendientes</h1>
        @if (_queue.Count > 0)
        {
            <span class="badge bg-warning text-dark fs-6">@_queue.Count en cola</span>
        }
    </div>

    @if (_loading)
    {
        <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
    }
    else if (_loadFailed)
    {
        <LoadError What="tus correcciones pendientes" OnRetry="LoadAsync" />
    }
    else if (_queue.Count == 0)
    {
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-inbox text-primary" style="font-size:2.5rem;"></i>
                <h5 class="mt-3">No tienes correcciones pendientes</h5>
                <p class="text-muted mb-0">
                    Aquí aparecerán los resultados de las pruebas que un administrador te asigne.
                </p>
            </div>
        </div>
    }
    else
    {
        <p class="text-muted small mb-3">
            Por defecto, ordenadas por antigüedad: arriba las que llevan más tiempo esperando.
        </p>
        <div class="row g-2 mb-3 align-items-center">
            <div class="col-md-6">
                <input class="form-control" type="search" placeholder="Buscar por prueba o candidato…"
                       aria-label="Buscar en tu cola" value="@_search"
                       @oninput="e => _search = e.Value?.ToString() ?? string.Empty" />
            </div>
            <div class="col-md-auto text-muted small">
                Mostrando <strong>@Displayed.Count</strong> de @_queue.Count
            </div>
        </div>
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <SortHeader Key="candidate" State="_sort" OnSort="SortBy" Class="ps-3">Candidato</SortHeader>
                                <SortHeader Key="exam" State="_sort" OnSort="SortBy">Prueba</SortHeader>
                                <SortHeader Key="sent" State="_sort" OnSort="SortBy">Enviada</SortHeader>
                                <SortHeader Key="waiting" State="_sort" OnSort="SortBy">Esperando</SortHeader>
                                <SortHeader Key="open" State="_sort" OnSort="SortBy">Por corregir</SortHeader>
                                <th class="text-end pe-3"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var q in Displayed)
                            {
                                <tr>
                                    <td class="ps-3 fw-semibold">@q.CandidateAlias</td>
                                    <td>@q.ExamTitle</td>
                                    <td class="text-muted small text-nowrap">@q.CompletedOn.ToString("dd/MM/yyyy")</td>
                                    <td>
                                        <span class="badge @WaitClass(q.DaysWaiting)">
                                            @(q.DaysWaiting == 0 ? "Hoy" : q.DaysWaiting == 1 ? "1 día" : $"{q.DaysWaiting} días")
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary">
                                            @q.OpenAnswerCount @(q.OpenAnswerCount == 1 ? "respuesta" : "respuestas")
                                        </span>
                                    </td>
                                    <td class="text-end pe-3 text-nowrap">
                                        @if (q.ReservedByOther)
                                        {
                                            <span class="badge bg-light text-dark border">
                                                <i class="bi bi-lock me-1"></i>
                                                En corrección hasta las @q.ReservedUntil?.ToLocalTime().ToString("HH:mm")
                                            </span>
                                        }
                                        else
                                        {
                                            <a href="/evaluacion/@q.ResultId" class="btn btn-sm btn-primary">
                                                <i class="bi bi-pencil-square me-1"></i> Corregir
                                            </a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool _loading = true, _loadFailed;
    private List<EvaluatorQueueItemDto> _queue = new();

    // Búsqueda y orden se conservan al abrir una corrección y volver. Sin orden elegido, el de la API (antigüedad).
    private const string StateKey = "evaluator-queue";
    private string _search = string.Empty;
    private readonly SortState _sort = new();
    private sealed record Saved(string Search, SortState Sort);

    private static readonly IReadOnlyDictionary<string, Func<EvaluatorQueueItemDto, object?>> Columns =
        new Dictionary<string, Func<EvaluatorQueueItemDto, object?>>
        {
            ["candidate"] = q => q.CandidateAlias,
            ["exam"] = q => q.ExamTitle,
            ["sent"] = q => q.CompletedOn,
            ["waiting"] = q => q.DaysWaiting,
            ["open"] = q => q.OpenAnswerCount
        };

    private List<EvaluatorQueueItemDto> Displayed => ListSort.Apply(
            _queue.Where(q => string.IsNullOrWhiteSpace(_search)
                || q.CandidateAlias.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase)
                || q.ExamTitle.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase)),
            _sort, Columns).ToList();

    private void SortBy(string key) => _sort.Toggle(key);

    public void Dispose() => Lists.Set(StateKey, new Saved(_search, _sort.Clone()));

    protected override async Task OnInitializedAsync()
    {
        await Auth.InitializeAsync();
        if (!Auth.IsEvaluador)
        {
            Nav.NavigateTo(Auth.Home);
            return;
        }

        if (Lists.Get<Saved>(StateKey) is { } saved)
        {
            _search = saved.Search;
            _sort.Key = saved.Sort.Key; _sort.Descending = saved.Sort.Descending;
        }

        await LoadAsync();
    }

    // Una cola que no carga no está vacía: sin esta distinción, la API caída le decía al
    // evaluador que no tenía correcciones.
    private async Task LoadAsync()
    {
        _loading = true;
        var queue = await Api.GetEvaluationQueueAsync();
        _loadFailed = queue is null;
        if (queue is not null) _queue = queue;
        _loading = false;
    }

    private static string WaitClass(int days) => days switch
    {
        >= 7 => "bg-danger",
        >= 3 => "bg-warning text-dark",
        _ => "bg-light text-dark border"
    };
}
