# Variables que docker-compose.yml necesita para levantar el stack.
#
# Copia este fichero a `.env` y rellena cada valor. `.env` está en .gitignore:
# NO lo subas al repositorio.
#
# El arranque falla nombrando la variable que falte, tanto en Compose como en la API.

# Contraseña del usuario `sa` de SQL Server.
# SQL Server exige 8 caracteres o más, con mayúsculas, minúsculas y dígitos o símbolos.
SA_PASSWORD=

# Clave de firma de los tokens de sesión. Debe ser larga y aleatoria.
# Para generarla:
#   openssl rand -base64 48
#   # o, en PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
#
# Cambiarla caduca de golpe todas las sesiones abiertas, incluidas las invitaciones
# de examen que estén en curso.
JWT_SECRET_KEY=

# Contraseña del administrador que se siembra en el primer arranque.
ADMIN_PASSWORD=

# Credenciales de envío de correo.
SENDGRID_API_KEY=
EMAIL_FROM=
