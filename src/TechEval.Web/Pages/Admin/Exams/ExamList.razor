@page "/admin/pruebas"
@implements IDisposable
@using TechEval.Application
@using TechEval.Application.DTOs
@inject ApiService Api
@inject NavigationManager Nav
@inject AuthStateService Auth
@inject ListState Lists

<PageTitle>Pruebas — TechEval</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0">Pruebas</h1>
        <div class="d-flex gap-2">
            <a href="/admin/pruebas/new" class="btn btn-outline-primary">
                <i class="bi bi-plus-lg me-1"></i> Manual
            </a>
            <a href="/admin/pruebas/generate" class="btn btn-primary">
                <i class="bi bi-magic me-1"></i> Generar automático
            </a>
        </div>
    </div>

    @if (_firstLoad)
    {
        <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
    }
    else if (_loadFailed)
    {
        <LoadError What="las pruebas" OnRetry="LoadAsync" />
    }
    else
    {
        @* Las pruebas son tarjetas, no una tabla: el orden se elige en un selector en lugar de en las cabeceras. *@
        <div class="row g-2 mb-3 align-items-center">
            <div class="col-md-5">
                <input class="form-control" type="search" placeholder="Buscar por título…"
                       aria-label="Buscar pruebas" value="@_search" @oninput="OnSearchInput" />
            </div>
            <div class="col-md-3">
                <select class="form-select" aria-label="Ordenar pruebas" value="@SortValue" @onchange="OnSortChange">
                    <option value="">Orden por defecto</option>
                    <option value="title">Título (A–Z)</option>
                    <option value="title-desc">Título (Z–A)</option>
                    <option value="created-desc">Más recientes primero</option>
                    <option value="created">Más antiguas primero</option>
                    <option value="questions-desc">Más preguntas primero</option>
                    <option value="results-desc">Más resultados primero</option>
                </select>
            </div>
        </div>
        @if (_exams.Count == 0 && !string.IsNullOrWhiteSpace(_search))
        {
            <div class="text-center text-muted py-5">Ninguna prueba coincide con la búsqueda.</div>
        }
        <div class="row g-4 @(_busy ? "opacity-50" : "")" aria-busy="@(_busy ? "true" : "false")">
            @foreach (var exam in _exams)
            {
                <div class="col-md-6 col-xl-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <h5 class="card-title mb-0">@exam.Title</h5>
                                <span class="badge @(exam.IsActive ? "bg-success" : "bg-secondary")">
                                    @(exam.IsActive ? "Activo" : "Inactivo")
                                </span>
                            </div>
                            <div class="row text-center g-2 mb-3">
                                <div class="col-4">
                                    <div class="bg-light rounded p-2">
                                        <div class="h5 mb-0">@exam.QuestionCount</div>
                                        <div class="text-muted small">Preguntas</div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="bg-light rounded p-2">
                                        <div class="h5 mb-0">@exam.TimeLimitMinutes'</div>
                                        <div class="text-muted small">Tiempo</div>
                                    </div>
                                </div>
                                <div class="col-4">
                                    <div class="bg-light rounded p-2">
                                        <div class="h5 mb-0">@exam.ResultsCount</div>
                                        <div class="text-muted small">Resultados</div>
                                    </div>
                                </div>
                            </div>
                            @if (exam.AbandonedCount > 0)
                            {
                                @* Empezaron y nadie las envió; se marcan solas pasado el plazo y la gracia. *@
                                <div class="small text-muted mb-3" title="Sesiones que empezaron y nadie envió">
                                    <i class="bi bi-person-x me-1"></i>
                                    <strong>@exam.AbandonedCount</strong> @(exam.AbandonedCount == 1 ? "abandonada" : "abandonadas")
                                </div>
                            }
                            <div class="d-flex gap-2">
                                <button class="btn btn-sm btn-primary flex-grow-1"
                                        @onclick="() => SendExam(exam.Id)">
                                    <i class="bi bi-send me-1"></i> Enviar
                                </button>
                                <a href="/admin/pruebas/@exam.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                @* Los resultados de ESTA prueba: la ruta anterior pasaba un parámetro que el
                                   listado global ignora, y abría todos los resultados. *@
                                <a href="/admin/results/prueba/@exam.Id" class="btn btn-sm btn-outline-secondary"
                                   title="Resultados de esta prueba" aria-label="Resultados de esta prueba">
                                    <i class="bi bi-bar-chart"></i>
                                </a>
                                <button class="btn btn-sm btn-outline-danger"
                                        @onclick="() => DeleteAsync(exam.Id)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        @if (!_exams.Any() && string.IsNullOrWhiteSpace(_search))
        {
            <div class="text-center text-muted py-5">
                <i class="bi bi-journal-x fs-1"></i>
                <p class="mt-2">No hay pruebas creadas aún.</p>
            </div>
        }

        <Pager State="_page" Noun="pruebas" Sizes="CardSizes" OnPage="GoToPageAsync" OnPageSize="SetPageSizeAsync" />
    }
</div>

<!-- Modal envío -->
@if (_sendingExamId.HasValue)
{
    <div class="modal d-block" style="background: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-dialog-centered @(_isBulkMode ? "modal-lg" : "")">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Enviar prueba</h5>
                    <button class="btn-close" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">

                    <!-- Selector de modo -->
                    @if (_bulkResult is null && !_sendSuccess)
                    {
                        <div class="btn-group w-100 mb-4" role="group">
                            <button type="button"
                                    class="btn @(_isBulkMode ? "btn-outline-primary" : "btn-primary")"
                                    @onclick="() => { _isBulkMode = false; _sendError = string.Empty; }">
                                <i class="bi bi-person me-1"></i> Individual
                            </button>
                            <button type="button"
                                    class="btn @(_isBulkMode ? "btn-primary" : "btn-outline-primary")"
                                    @onclick="() => { _isBulkMode = true; _sendError = string.Empty; }">
                                <i class="bi bi-people me-1"></i> Masivo
                            </button>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(_sendError))
                    {
                        <div class="alert alert-danger">@_sendError</div>
                    }

                    @if (!_isBulkMode)
                    {
                        <!-- MODO INDIVIDUAL -->
                        @if (_sendSuccess)
                        {
                            <div class="alert alert-success">
                                <i class="bi bi-check-circle me-1"></i> Prueba enviada correctamente a <strong>@_candidateEmail</strong>
                            </div>
                        }
                        else
                        {
                            <div class="mb-3">
                                <label class="form-label">Nombre del candidato</label>
                                <input class="form-control" @bind="_candidateName" placeholder="Juan García" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Email del candidato</label>
                                <input type="email" class="form-control" @bind="_candidateEmail" placeholder="juan@empresa.com" />
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Expiración (horas)</label>
                                <input type="number" class="form-control" @bind="_expirationHours" min="@TechEval.Application.ExamLimits.MinExpirationHours" max="@TechEval.Application.ExamLimits.MaxExpirationHours" />
                            </div>
                        }
                    }
                    else
                    {
                        <!-- MODO MASIVO -->
                        @if (_bulkResult is not null)
                        {
                            <!-- Resultado del envío masivo -->
                            <div class="alert @(_bulkResult.Failed == 0 ? "alert-success" : "alert-warning")">
                                <i class="bi bi-check-circle me-1"></i>
                                <strong>@_bulkResult.Sent</strong> enviados correctamente
                                @if (_bulkResult.Failed > 0)
                                {
                                    <span> · <strong>@_bulkResult.Failed</strong> fallidos</span>
                                }
                            </div>
                            @if (_bulkResult.Failed > 0)
                            {
                                <h6 class="text-danger mb-2">Candidatos con error:</h6>
                                <div class="table-responsive">
                                    <table class="table table-sm table-bordered">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Nombre</th>
                                                <th>Email</th>
                                                <th>Error</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var r in _bulkResult.Results.Where(r => !r.Success))
                                            {
                                                <tr>
                                                    <td>@r.CandidateName</td>
                                                    <td>@r.CandidateEmail</td>
                                                    <td class="text-danger small">@r.Error</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        }
                        else
                        {
                            <!-- Selector de método de entrada -->
                            <ul class="nav nav-tabs mb-3">
                                <li class="nav-item">
                                    <button class="nav-link @(_bulkInputMode == "manual" ? "active" : "")"
                                            @onclick='() => _bulkInputMode = "manual"'>
                                        <i class="bi bi-table me-1"></i> Manual
                                    </button>
                                </li>
                                <li class="nav-item">
                                    <button class="nav-link @(_bulkInputMode == "csv" ? "active" : "")"
                                            @onclick='() => _bulkInputMode = "csv"'>
                                        <i class="bi bi-filetype-csv me-1"></i> Pegar CSV
                                    </button>
                                </li>
                            </ul>

                            @if (_bulkInputMode == "manual")
                            {
                                <!-- Lista manual de candidatos -->
                                @if (_bulkCandidates.Any())
                                {
                                    <div class="table-responsive mb-3">
                                        <table class="table table-sm table-bordered align-middle">
                                            <thead class="table-light">
                                                <tr>
                                                    <th>Nombre</th>
                                                    <th>Email</th>
                                                    <th></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @for (int i = 0; i < _bulkCandidates.Count; i++)
                                                {
                                                    var idx = i;
                                                    <tr>
                                                        <td>@_bulkCandidates[idx].Name</td>
                                                        <td>@_bulkCandidates[idx].Email</td>
                                                        <td class="text-center">
                                                            <button class="btn btn-sm btn-outline-danger"
                                                                    @onclick="() => _bulkCandidates.RemoveAt(idx)">
                                                                <i class="bi bi-trash"></i>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                                <div class="row g-2 align-items-end mb-3">
                                    <div class="col">
                                        <label class="form-label small">Nombre</label>
                                        <input class="form-control form-control-sm" @bind="_newBulkName"
                                               placeholder="Juan García" />
                                    </div>
                                    <div class="col">
                                        <label class="form-label small">Email</label>
                                        <input type="email" class="form-control form-control-sm" @bind="_newBulkEmail"
                                               placeholder="juan@empresa.com" />
                                    </div>
                                    <div class="col-auto">
                                        <button class="btn btn-sm btn-outline-primary" @onclick="AddBulkCandidate">
                                            <i class="bi bi-plus-lg"></i> Añadir
                                        </button>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <!-- Entrada CSV -->
                                <div class="mb-2 text-muted small">
                                    Una línea por candidato: <code>Nombre;Email</code> (también vale coma o tabulador, y se ignora una primera línea de encabezado)
                                </div>
                                <textarea class="form-control font-monospace mb-2" rows="6"
                                          @bind="_csvInput"
                                          placeholder="Juan García;juan@empresa.com&#10;Ana López;ana@empresa.com&#10;Pedro Ruiz;pedro@empresa.com"></textarea>
                                <button class="btn btn-sm btn-outline-secondary mb-3" @onclick="ParseCsv">
                                    <i class="bi bi-arrow-repeat me-1"></i> Importar
                                </button>
                                @if (_csvReport is { } report)
                                {
                                    @* Siempre se dice qué pasó: «0 importados» sin explicación era lo que hacía un CSV
                                       separado por punto y coma. *@
                                    @if (_bulkCandidates.Any())
                                    {
                                        <div class="alert alert-info py-2 small mb-2" role="status">
                                            <i class="bi bi-people me-1"></i>
                                            <strong>@_bulkCandidates.Count</strong>
                                            @(_bulkCandidates.Count == 1 ? "candidato importado" : "candidatos importados").
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="alert alert-warning py-2 small mb-2" role="status">
                                            <i class="bi bi-exclamation-triangle me-1"></i>
                                            <strong>No se importó ningún candidato.</strong>
                                            Escribe una línea por candidato con el nombre y el correo separados por
                                            <code>;</code>, coma o tabulador, por ejemplo <code>Ana López;ana@empresa.com</code>.
                                        </div>
                                    }
                                    @if (report.Issues.Count > 0)
                                    {
                                        <div class="alert alert-warning py-2 small" role="alert">
                                            <strong>@report.Issues.Count
                                                @(report.Issues.Count == 1 ? "línea ignorada" : "líneas ignoradas"):</strong>
                                            <ul class="mb-0 ps-3">
                                                @foreach (var issue in report.Issues)
                                                {
                                                    <li>Línea @issue.Line: @issue.Reason</li>
                                                }
                                            </ul>
                                        </div>
                                    }
                                }
                            }

                            <div class="mb-1">
                                <label class="form-label">Expiración (horas)</label>
                                <input type="number" class="form-control" @bind="_expirationHours" min="@TechEval.Application.ExamLimits.MinExpirationHours" max="@TechEval.Application.ExamLimits.MaxExpirationHours" />
                            </div>
                        }
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-outline-secondary" @onclick="CloseModal">
                        @((_sendSuccess || _bulkResult is not null) ? "Cerrar" : "Cancelar")
                    </button>
                    @if (!_sendSuccess && _bulkResult is null)
                    {
                        @if (!_isBulkMode)
                        {
                            <button class="btn btn-primary" @onclick="ConfirmSendAsync" disabled="@_sendLoading">
                                @if (_sendLoading) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                Enviar
                            </button>
                        }
                        else
                        {
                            <button class="btn btn-primary" @onclick="ConfirmBulkSendAsync"
                                    disabled="@(_sendLoading || !_bulkCandidates.Any())">
                                @if (_sendLoading) { <span class="spinner-border spinner-border-sm me-1"></span> }
                                Enviar a @_bulkCandidates.Count candidato@(_bulkCandidates.Count == 1 ? "" : "s")
                            </button>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ExamSummaryDto> _exams = new();
    private bool _firstLoad = true, _busy, _loadFailed;

    // Búsqueda, orden y página se conservan al abrir una prueba y volver.
    private const string StateKey = "exams";
    private string _search = string.Empty;
    private readonly SortState _sort = new();
    // Tarjetas en filas de 3: los tamaños son múltiplos de 3.
    private static readonly int[] CardSizes = { 6, 12, 24, 48 };
    private readonly PageState _page = new() { PageSize = 12 };
    private readonly ListLoader _loader = new();
    private sealed record Saved(string Search, SortState Sort, int Page, int PageSize);

    // El selector junta columna y dirección en un solo valor: «title», «title-desc»…
    private string SortValue => _sort.Key is null ? "" : _sort.Descending ? _sort.Key + "-desc" : _sort.Key;

    private async Task OnSortChange(ChangeEventArgs e)
    {
        var value = e.Value?.ToString() ?? "";
        _sort.Descending = value.EndsWith("-desc");
        _sort.Key = value.Length == 0 ? null : value.Replace("-desc", "");
        _page.Reset();
        await LoadAsync();
    }

    private Task OnSearchInput(ChangeEventArgs e)
    {
        _search = e.Value?.ToString() ?? string.Empty;
        _page.Reset();
        _ = _loader.DebounceAsync(LoadAsync);
        return Task.CompletedTask;
    }

    private async Task GoToPageAsync(int page)
    {
        _page.Page = page;
        await LoadAsync();
    }

    private async Task SetPageSizeAsync(int size)
    {
        _page.SetPageSize(size);
        await LoadAsync();
    }

    public void Dispose()
    {
        Lists.Set(StateKey, new Saved(_search, _sort.Clone(), _page.Page, _page.PageSize));
        _loader.Dispose();
    }

    // Estado individual
    private int? _sendingExamId;
    private string _candidateName = string.Empty;
    private string _candidateEmail = string.Empty;
    private int _expirationHours = 72;
    private bool _sendLoading, _sendSuccess;
    private string _sendError = string.Empty;

    // Estado masivo
    private bool _isBulkMode;
    private string _bulkInputMode = "manual";
    private string _csvInput = string.Empty;
    private List<BulkCandidateDto> _bulkCandidates = new();
    private string _newBulkName = string.Empty;
    private string _newBulkEmail = string.Empty;
    private BulkSendResultDto? _bulkResult;

    protected override async Task OnInitializedAsync()
    {
        await Auth.InitializeAsync();
        if (!Auth.IsAdmin) { Nav.NavigateTo(Auth.Home); return; }

        if (Lists.Get<Saved>(StateKey) is { } saved)
        {
            _search = saved.Search;
            _sort.Key = saved.Sort.Key; _sort.Descending = saved.Sort.Descending;
            _page.Page = saved.Page; _page.PageSize = saved.PageSize;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _busy = true;

        // Si la página guardada ya no existe, o se vació al dar de baja la última tarjeta, se pide la última.
        for (var attempt = 0; attempt < 2; attempt++)
        {
            var again = false;
            var query = _page.ToQuery(_search, _sort);
            var applied = await _loader.LoadAsync(() => Api.GetExamsPageAsync(query), r =>
            {
                _loadFailed = r is null;
                if (r is null) return;

                var beyond = _page.IsBeyondEnd(r);
                _page.Apply(r);
                if (beyond) { _page.GoToLast(); again = true; return; }
                _exams = r.Items.ToList();
            });

            if (!applied) return;
            if (!again) break;
        }

        _firstLoad = false;
        _busy = false;
        StateHasChanged();
    }

    private void SendExam(int id)
    {
        _sendingExamId = id;
        _candidateName = _candidateEmail = _sendError = string.Empty;
        _sendSuccess = _sendLoading = false;
        _expirationHours = 72;
        _isBulkMode = false;
        _bulkInputMode = "manual";
        _bulkCandidates = new();
        _csvReport = null;
        _newBulkName = _newBulkEmail = _csvInput = string.Empty;
        _bulkResult = null;
    }

    private void CloseModal() => _sendingExamId = null;

    private async Task ConfirmSendAsync()
    {
        _sendError = string.Empty;
        if (string.IsNullOrWhiteSpace(_candidateName) || string.IsNullOrWhiteSpace(_candidateEmail))
        { _sendError = "Nombre y email son obligatorios."; return; }

        _sendLoading = true;
        var (token, _, error) = await Api.SendExamAsync(new SendExamDto(
            _sendingExamId!.Value, _candidateName, _candidateEmail, _expirationHours));
        _sendLoading = false;

        // El motivo es el del servidor (prueba desactivada, correo inválido...). El texto de
        // la configuración del correo queda para cuando no hay otro.
        if (token is not null) _sendSuccess = true;
        else _sendError = error ?? "No se pudo enviar la prueba. Verifica la configuración de email.";
    }

    private void AddBulkCandidate()
    {
        if (string.IsNullOrWhiteSpace(_newBulkName) || string.IsNullOrWhiteSpace(_newBulkEmail))
            return;
        _bulkCandidates.Add(new BulkCandidateDto(_newBulkName.Trim(), _newBulkEmail.Trim()));
        _newBulkName = _newBulkEmail = string.Empty;
    }

    private TechEval.Application.CsvParseResult? _csvReport;

    private void ParseCsv()
    {
        // El analizador acepta ; tabulador o coma, ignora el encabezado y valida cada correo. El
        // informe dice siempre cuántos entraron y por qué se ignoró el resto.
        _csvReport = TechEval.Application.CandidateCsvParser.Parse(_csvInput);
        _bulkCandidates = _csvReport.Candidates;
    }

    private async Task ConfirmBulkSendAsync()
    {
        _sendError = string.Empty;
        if (!_bulkCandidates.Any())
        { _sendError = "Añade al menos un candidato antes de enviar."; return; }

        _sendLoading = true;
        var (result, _, error) = await Api.SendExamBulkAsync(new BulkSendExamDto(
            _sendingExamId!.Value, _bulkCandidates, _expirationHours));
        _sendLoading = false;

        _bulkResult = result;
        if (result is null)
            _sendError = error ?? "No se pudo conectar con la API. Verifica la configuración.";
    }

    private async Task DeleteAsync(int id)
    {
        // Dar de baja la desactiva. Se recarga la página en vez de quitar la tarjeta: sigue en el
        // listado, marcada como inactiva, y el total y las páginas se mantienen verdaderos.
        if (await Api.DeleteExamAsync(id))
            await LoadAsync();
    }
}
