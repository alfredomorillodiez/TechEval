@inherits LayoutComponentBase
@inject AuthStateService Auth
@inject NavigationManager Nav

<div class="d-flex min-vh-100">
    @if (Auth.IsAuthenticated)
    {
        <!-- Sidebar -->
        <nav class="bg-dark text-white d-flex flex-column p-3" style="width:250px;min-height:100vh;">
            <div class="mb-4 pb-3 border-bottom border-secondary">
                <h6 class="text-white mb-0 fw-bold">TechEval</h6>
                <small class="text-muted">@Auth.UserName</small>
            </div>
            <ul class="nav flex-column gap-1 flex-grow-1">
                <li class="nav-item">
                    <a class="nav-link text-white d-flex align-items-center gap-2 rounded" href="/admin">
                        <i class="bi bi-speedometer2"></i> Dashboard
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white d-flex align-items-center gap-2 rounded" href="/admin/questions">
                        <i class="bi bi-question-circle"></i> Preguntas
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white d-flex align-items-center gap-2 rounded" href="/admin/exams">
                        <i class="bi bi-file-earmark-text"></i> Exámenes
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white d-flex align-items-center gap-2 rounded" href="/admin/results">
                        <i class="bi bi-bar-chart"></i> Resultados
                    </a>
                </li>
            </ul>
            <div class="border-top border-secondary pt-3">
                <button class="btn btn-outline-secondary btn-sm w-100" @onclick="LogoutAsync">
                    <i class="bi bi-box-arrow-right me-1"></i> Cerrar sesión
                </button>
            </div>
        </nav>
    }

    <main class="flex-grow-1 bg-light overflow-auto">
        @Body
    </main>
</div>

@code {
    protected override async Task OnInitializedAsync()
        => await Auth.InitializeAsync();

    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("/login");
    }
}
