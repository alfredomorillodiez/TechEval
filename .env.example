# Variables que docker-compose.yml necesita para levantar el stack.
#
# Copia este fichero a `.env` y rellena cada valor. `.env` está en .gitignore:
# NO lo subas al repositorio.
#
# El arranque falla nombrando la variable que falte, tanto en Compose como en la API.

# Edición de SQL Server. Hay que elegirla: el arranque falla si falta.
#   Developer  — gratuita, pero SOLO para desarrollo y pruebas. No tiene licencia para producción.
#   Express    — gratuita y con licencia de producción. Límite de 10 GB por base de datos.
#   Standard · Enterprise — con licencia.
MSSQL_PID=Developer

# Contraseña del usuario `sa` de SQL Server.
# SQL Server exige 8 caracteres o más, con mayúsculas, minúsculas y dígitos o símbolos.
SA_PASSWORD=

# Clave de firma de los tokens de sesión. Debe ser larga y aleatoria.
# Para generarla:
#   openssl rand -base64 48
#   # o, en PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }))
#
# Cambiarla caduca de golpe todas las sesiones abiertas, incluidas las invitaciones
# de examen que estén en curso.
JWT_SECRET_KEY=

# Contraseña del administrador que se siembra en el primer arranque.
ADMIN_PASSWORD=

# Envío de correo con Microsoft Graph.
# EMAIL_FROM es el buzón que envía, y también el remitente que ve el destinatario.
EMAIL_FROM=
# Aplicación de Entra ID con el permiso de aplicación Mail.Send de Microsoft Graph y
# consentimiento de administrador. Los da el departamento de sistemas.
O365_TENANT_ID=
O365_CLIENT_ID=
O365_CLIENT_SECRET=

# ---------------------------------------------------------------------------------------------
# Dónde está cada parte, vista desde el NAVEGADOR de quien usa la aplicación.
# Los dos valores de abajo valen para probar en este equipo. Fuera de él hay que cambiarlos.
#
# Sin barra final en FRONTEND_BASE_URL: se usa tal cual como origen de CORS. La barra final de
# API_BASE_URL se añade sola.
#
# nginx y la API escuchan en HTTP. El certificado lo pone un proxy inverso delante: ver el apartado
# del README sobre el despliegue detrás de un proxy.
# ---------------------------------------------------------------------------------------------

# La web. Es el origen que acepta la API (CORS) y la base de los enlaces de los correos.
# Un valor equivocado hace que las invitaciones lleven a una página que no existe.
FRONTEND_BASE_URL=http://localhost:5001

# La API. La web la llama desde el navegador. Se escribe en la web al arrancar el contenedor.
API_BASE_URL=http://localhost:5000/
